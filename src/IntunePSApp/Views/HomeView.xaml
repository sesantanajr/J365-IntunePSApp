<UserControl x:Class="J365.IntunePSApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,6,28,28" MaxWidth="1240">

      <!-- Destaque -->
      <Border CornerRadius="16" Background="{StaticResource HeroBrush}" Padding="36,32" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
            <Border Background="#1FFFFFFF" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
              <TextBlock Text="PSAppDeployToolkit 4  ·  Microsoft Intune  ·  Código aberto" Foreground="#CFE6FA" FontSize="12"/>
            </Border>
            <TextBlock Text="Empacote qualquer aplicativo para o Intune em minutos" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock Foreground="#C9DBF0" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Escolha um app do catálogo ou arraste o instalador. O IntunePSApp gera o pacote PSADT com a identidade da sua empresa, ações sem script, detecção e o arquivo .intunewin pronto para enviar."/>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button Style="{StaticResource HeroButton}" Click="Catalog_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Buscar no catálogo"/></StackPanel>
              </Button>
              <Button Style="{StaticResource HeroOutlineButton}" Margin="12,0,0,0" Click="Package_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="Empacotar um instalador"/></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <Grid Grid.Column="1" Width="250" Margin="24,0,8,0" VerticalAlignment="Center">
            <Ellipse Width="230" Height="230" Fill="#14FFFFFF"/>
            <Ellipse Width="170" Height="170" Fill="#14FFFFFF"/>
            <Image Source="/Assets/j365-cloud.png" Width="190" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Indicadores -->
      <UniformGrid Columns="4" Margin="-8,18,-8,0">
        <Border Style="{StaticResource Card}" Margin="8,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="Aplicativos no banco" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatApps" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatAppsSub" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="Pacotes gerados" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatPackages" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatPackagesSub" Style="{StaticResource MutedText}" Text="nesta pasta de saída"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="PSAppDeployToolkit" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatPsadt" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatPsadtSub" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="Content Prep Tool" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatIwau" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatIwauSub" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Como funciona -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Como funciona" Style="{StaticResource H2}"/>
            <TextBlock Text="Três passos, sem escrever scripts." Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
            <ItemsControl x:Name="Steps">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Item1}" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Item2}" Style="{StaticResource H3}"/>
                      <TextBlock Text="{Binding Item3}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Recentes -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="Ver todos" Style="{StaticResource GhostButton}" Click="Packages_Click"/>
              <TextBlock Text="Pacotes recentes" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="RecentEmpty" Style="{StaticResource MutedText}" Text="Nenhum pacote gerado ainda. Comece pelo catálogo ou arraste um instalador." Margin="0,6,0,0"/>
            <ItemsControl x:Name="Recent">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Navy}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}"/>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Abrir pasta" Tag="{Binding Folder}" Click="OpenFolder_Click">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
