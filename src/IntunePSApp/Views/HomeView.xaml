<UserControl x:Class="J365.IntunePSApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,6,28,28" MaxWidth="1240">

      <!-- Hero -->
      <Border CornerRadius="16" Background="{StaticResource HeroBrush}" Padding="36,32" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
            <Border Background="#1FFFFFFF" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
              <TextBlock Text="{l:T Home_Badge}" Foreground="#CFE6FA" FontSize="12"/>
            </Border>
            <TextBlock Text="{l:T Home_Title}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock Text="{l:T Home_Subtitle}" Foreground="#C9DBF0" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,16,0,0">
              <Button Style="{StaticResource HeroButton}" Margin="0,8,12,0" Click="Catalog_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{l:T Home_SearchCatalog}"/></StackPanel>
              </Button>
              <Button Style="{StaticResource HeroOutlineButton}" Margin="0,8,0,0" Click="Package_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="{l:T Home_PackageInstaller}"/></StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
          <Grid x:Name="HeroArt" Grid.Column="1" Width="250" Margin="24,0,8,0" VerticalAlignment="Center">
            <Ellipse Width="230" Height="230" Fill="#14FFFFFF"/>
            <Ellipse Width="170" Height="170" Fill="#14FFFFFF"/>
            <Image Source="/Assets/j365-cloud.png" Width="190" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Notices: new versions, missing dependencies, packages to update -->
      <ItemsControl x:Name="Notices" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Notice}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding ButtonText}" Padding="14,7" VerticalAlignment="Center" Margin="16,0,0,0" Click="Notice_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" FontSize="18" Margin="2,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Text}" Foreground="{StaticResource Ink2}" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Indicators -->
      <UniformGrid x:Name="Stats" Columns="4" Margin="-8,18,-8,0">
        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="{l:T Home_StatApps}" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatApps" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatAppsSub" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="{l:T Home_StatPackages}" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatPackages" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatPackagesSub" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="PSAppDeployToolkit" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatPsadt" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatPsadtSub" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0,8,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" Margin="0,0,8,0"/><TextBlock Text="Content Prep Tool" Style="{StaticResource MutedText}"/></StackPanel>
            <TextBlock x:Name="StatIwau" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatIwauSub" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Two columns on wide windows, one card under the other on narrow ones (HomeView.ApplyResponsiveLayout) -->
      <Grid x:Name="Info" Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- How it works -->
        <Border x:Name="HowCard" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{l:T Home_HowTitle}" Style="{StaticResource H2}"/>
            <TextBlock Text="{l:T Home_HowSubtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
            <ItemsControl x:Name="Steps" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource BrandSoft}" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Item1}" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Item2}" Style="{StaticResource H3}"/>
                      <TextBlock Text="{Binding Item3}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Recent packages -->
        <Border x:Name="RecentCard" Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="{l:T Home_ViewAll}" Style="{StaticResource GhostButton}" Click="Packages_Click"/>
              <TextBlock Text="{l:T Home_Recent}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="RecentEmpty" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Text="{l:T Home_RecentEmpty}" Margin="0,6,0,0"/>
            <ItemsControl x:Name="Recent" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource Navy}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DateLabel}" Style="{StaticResource MutedText}"/>
                      </StackPanel>
                      <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource WarningSoft}" Margin="0,0,8,0" VerticalAlignment="Center"
                              Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UpdateLabel}" Foreground="{StaticResource Warning}" FontSize="11.5" FontWeight="SemiBold"/>
                      </Border>
                      <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="{l:T Common_OpenFolder}" Tag="{Binding Folder}" Click="OpenFolder_Click">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Jornada 365: the blog behind the project -->
      <Border Style="{StaticResource Card}" Margin="0,18,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Left" Style="{StaticResource LogoBadge}" Padding="0" Margin="0,0,22,0" VerticalAlignment="Center" Click="Blog_Click" ToolTip="jornada365.cloud">
            <Image Source="/Assets/j365-logo.png" Height="58" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Click="Blog_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T Home_BlogButton}"/></StackPanel>
          </Button>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{l:T Home_BlogTitle}" Style="{StaticResource H3}" TextWrapping="Wrap"/>
            <TextBlock Text="{l:T Home_BlogText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
