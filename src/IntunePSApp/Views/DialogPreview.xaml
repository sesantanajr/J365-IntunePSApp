<UserControl x:Class="J365.IntunePSApp.Views.DialogPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization">
  <!-- The welcome dialog of PSAppDeployToolkit 4.1.8 as the package shows it, in its two styles, drawn from the layout of
       the toolkit (FluentDialog.xaml, Classic CloseAppsDialog). It shows the light Windows dialog whatever the theme of
       this application, so its colors are fixed. -->
  <Grid>
    <!-- Fluent: accent sidebar with the toolkit logo; header; card with the message, the applications and the
         countdown rows; the accent button on the left and Defer on the right, in two equal halves. -->
    <Border x:Name="FluentCard" Background="#F3F3F3" CornerRadius="8" BorderBrush="#D6DAE1" BorderThickness="1" Effect="{DynamicResource CardShadow}" TextElement.Foreground="#1B1B1B">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="FSidebar" CornerRadius="7,0,0,7" Background="{DynamicResource Brand}">
          <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="10" Foreground="White" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0"/>
        </Border>
        <StackPanel Grid.Column="1">
          <Grid Margin="14,14,14,10">
            <Image x:Name="FLogo" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="50,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Foreground="#1B1B1B"/>
              <TextBlock x:Name="FSubtitle" FontSize="11" TextWrapping="Wrap" Foreground="#5F5F5F" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <Border Margin="14,0,14,10" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock x:Name="FBody" Margin="12,11,12,9" FontSize="12.5" TextWrapping="Wrap" Foreground="#1B1B1B"/>
              <TextBlock x:Name="FCustom" Margin="12,0,12,9" FontSize="12.5" TextWrapping="Wrap" Foreground="#1B1B1B"/>
              <Grid x:Name="FAppRow" Margin="12,0,12,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Image x:Name="FAppIcon" Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="FAppName" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1B1B1B"/>
                  <TextBlock x:Name="FAppExe" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
              <DockPanel x:Name="FCountdownRow" Margin="12,9,12,9">
                <TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="13" Foreground="#1B1B1B" VerticalAlignment="Center"/>
                <TextBlock x:Name="FCountdownValue" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="#1B1B1B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="FCountdownLabel" FontSize="12.5" TextWrapping="Wrap" Foreground="#1B1B1B" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Grid Margin="14,0,14,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border x:Name="FMainBtn" Grid.Column="1" CornerRadius="4" Padding="6,7" Margin="3,0,0,0" Background="{DynamicResource Brand}">
              <TextBlock x:Name="FMainText" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Classic: Windows dialog with the banner of the company; centred texts; Close Programs, Defer and Continue. -->
    <Border x:Name="ClassicCard" Background="#F0F0F0" BorderBrush="#7A7A7A" BorderThickness="1" Visibility="Collapsed" Effect="{DynamicResource CardShadow}" TextElement.Foreground="#1F1F1F">
      <StackPanel>
        <DockPanel Background="White" Height="28">
          <Image x:Name="CIcon" Width="16" Height="16" Margin="8,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="CWindowTitle" VerticalAlignment="Center" FontSize="12" Foreground="#1F1F1F" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Background="White" Height="52">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,4">
            <Image x:Name="CBannerLogo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="CBannerText" FontSize="16" FontWeight="Bold" Foreground="#20242C" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <Border x:Name="CAccentBar" Height="4" VerticalAlignment="Bottom" Background="{DynamicResource Brand}"/>
        </Grid>
        <StackPanel Margin="14,10,14,0">
          <TextBlock x:Name="CWelcome" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock x:Name="CTitle" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock x:Name="CCustom" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock x:Name="CCloseApps" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
          <Border x:Name="CAppsBox" Margin="0,6,0,0" Background="White" BorderBrush="#ABADB3" BorderThickness="1" Padding="6,4">
            <TextBlock x:Name="CApps" FontSize="12"/>
          </Border>
          <TextBlock x:Name="CCountdownLabel" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
          <TextBlock x:Name="CCountdownValue" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
        </StackPanel>
        <UniformGrid Columns="3" Margin="14,12,14,12">
          <Border x:Name="CCloseBtn" Background="#E1E1E1" BorderBrush="#ADADAD" BorderThickness="1" Padding="6,4" Margin="0,0,4,0"><TextBlock x:Name="CCloseText" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
          <Border x:Name="CDeferBtn" Background="#E1E1E1" BorderBrush="#ADADAD" BorderThickness="1" Padding="6,4" Margin="2,0,2,0"><TextBlock x:Name="CDeferText" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
          <Border Background="#E1E1E1" BorderBrush="#ADADAD" BorderThickness="1" Padding="6,4" Margin="4,0,0,0"><TextBlock x:Name="CContinueText" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- At this moment the package shows no dialog. -->
    <Border x:Name="HiddenCard" Visibility="Collapsed" Background="{DynamicResource SurfaceHover}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="10" Padding="16,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xED1A;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <TextBlock Text="{l:T Prev_HiddenTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="HiddenText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
