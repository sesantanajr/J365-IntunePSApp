<UserControl x:Class="J365.IntunePSApp.Views.DialogPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization">
  <!-- Approximation of the PSAppDeployToolkit 4 welcome dialog, in its two styles. -->
  <Grid>
    <!-- Fluent: rounded window, the app icon, accent-coloured main button -->
    <Border x:Name="FluentCard" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Effect="{StaticResource CardShadow}">
      <StackPanel>
        <Grid Margin="18,16,18,0">
          <Image x:Name="FLogo" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="52,0,0,0">
            <TextBlock x:Name="FTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
            <TextBlock x:Name="FSubtitle" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="FBody" Margin="18,14,18,0" Style="{StaticResource Body}"/>
        <Border x:Name="FAppsBox" Margin="18,10,18,0" Background="{StaticResource Subtle}" CornerRadius="7" Padding="10,8">
          <TextBlock x:Name="FApps" Style="{StaticResource Body}"/>
        </Border>
        <TextBlock x:Name="FCustom" Margin="18,10,18,0" Style="{StaticResource Body}" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="FDefer" Margin="18,10,18,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,18">
          <Border x:Name="FDeferBtn" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="5" Padding="12,6"><TextBlock Text="{l:T Prev_Defer}"/></Border>
          <Border x:Name="FMainBtn" CornerRadius="5" Padding="12,6" Margin="8,0,0,0" Background="{StaticResource Brand}"><TextBlock x:Name="FMainText" Foreground="White"/></Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Classic: square Windows dialog with the banner of the company (logo, name and accent line) -->
    <Border x:Name="ClassicCard" Background="#F0F0F0" BorderBrush="#7A7A7A" BorderThickness="1" Visibility="Collapsed" Effect="{StaticResource CardShadow}">
      <StackPanel>
        <DockPanel Background="White" Height="28">
          <Image x:Name="CIcon" Width="16" Height="16" Margin="8,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="CWindowTitle" VerticalAlignment="Center" FontSize="12" Foreground="#1F1F1F" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Grid Background="White" Height="52">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,4">
            <Image x:Name="CBannerLogo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="CBannerText" FontSize="16" FontWeight="Bold" Foreground="#20242C" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <Border x:Name="CAccentBar" Height="4" VerticalAlignment="Bottom" Background="{StaticResource Brand}"/>
        </Grid>
        <TextBlock x:Name="CBody" Margin="14,12,14,0" FontSize="12" TextWrapping="Wrap" Foreground="#1F1F1F"/>
        <Border x:Name="CAppsBox" Margin="14,8,14,0" Background="White" BorderBrush="#ABADB3" BorderThickness="1" Padding="6,4">
          <TextBlock x:Name="CApps" FontSize="12" Foreground="#1F1F1F"/>
        </Border>
        <TextBlock x:Name="CCustom" Margin="14,8,14,0" FontSize="12" TextWrapping="Wrap" Foreground="#1F1F1F"/>
        <TextBlock x:Name="CDefer" Margin="14,8,14,0" FontSize="12" TextWrapping="Wrap" Foreground="#3C3C3C"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,14,14,14">
          <Border x:Name="CDeferBtn" Background="#E1E1E1" BorderBrush="#ADADAD" BorderThickness="1" Padding="14,4"><TextBlock Text="{l:T Prev_Defer}" FontSize="12"/></Border>
          <Border Background="#E1E1E1" BorderBrush="#0078D7" BorderThickness="1" Padding="14,4" Margin="8,0,0,0"><TextBlock x:Name="CMainText" FontSize="12"/></Border>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
