<UserControl x:Class="J365.IntunePSApp.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,6,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Click="OpenOutput_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Abrir pasta de saída"/></StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Atualizar"/></StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Pacotes gerados" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <Border x:Name="Empty" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="32,28" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
        <TextBlock Text="Nenhum pacote gerado ainda" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
        <TextBlock Text="Os pacotes criados aparecem aqui, com atalhos para a pasta, as instruções do Intune e para reabrir o projeto." Style="{StaticResource MutedText}" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <ListBox x:Name="List" Grid.Row="1" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Navy}">
                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15"/>
                <TextBlock Style="{StaticResource MutedText}">
                  <Run Text="{Binding Vendor, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DateLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Reopen_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Reabrir"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Instructions_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Instruções"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Folder_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Pasta"/></StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
