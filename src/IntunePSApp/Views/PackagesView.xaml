<UserControl x:Class="J365.IntunePSApp.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization">
  <Grid Margin="28,6,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource SecondaryButton}" Click="OpenOutput_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Packages_OpenOutput}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Refresh_Click">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Packages_Refresh}"/></StackPanel>
        </Button>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="{l:T Packages_Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      </StackPanel>
    </DockPanel>

    <Grid x:Name="FilterBar" Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="Filter" Padding="38,8,12,8" VerticalContentAlignment="Center" TextChanged="Filter_TextChanged"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Muted}" Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <TextBlock x:Name="FilterHint" Text="{l:T Packages_FilterHint}" Foreground="{DynamicResource Faint}" Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <CheckBox x:Name="OnlyOutdated" Grid.Column="1" Style="{StaticResource Switch}" Content="{l:T Packages_OnlyOutdated}" Margin="18,0,0,0" VerticalAlignment="Center" Checked="OnlyOutdated_Changed" Unchecked="OnlyOutdated_Changed"/>
    </Grid>

    <Border x:Name="Empty" Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="32,28" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Brand}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:T Packages_EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
        <TextBlock Text="{l:T Packages_EmptyText}" Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="560"/>
        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{l:T Home_SearchCatalog}" Click="Catalog_Click"/>
      </StackPanel>
    </Border>

    <ListBox x:Name="List" Grid.Row="2" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="11">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Navy}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasIcon}" Value="True"><Setter Property="Background" Value="{DynamicResource Subtle}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoIcon, Converter={StaticResource BoolToVis}}"/>
                  <Image Source="{Binding Icon, Converter={StaticResource PackageIcon}}" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                  <Border Style="{StaticResource Chip}" Background="{DynamicResource WarningSoft}" Margin="10,0,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" ToolTip="{l:T Packages_UpdateTip}">
                    <TextBlock Foreground="{DynamicResource Warning}" FontSize="11.5" FontWeight="SemiBold">
                      <Run Text="{l:T Packages_NewVersion}"/><Run Text=" "/><Run Text="{Binding LatestVersion, Mode=OneWay}"/>
                    </TextBlock>
                  </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource MutedText}">
                  <Run Text="{Binding Vendor, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding DateLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0" Tag="{Binding}" Click="Update_Click"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" ToolTip="{l:T Packages_UpdateTip}">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Packages_Update}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Reopen_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Packages_Reopen}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Instructions_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Packages_Instructions}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Tag="{Binding}" Click="Folder_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Packages_Folder}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource IconButton}" Tag="{Binding}" Click="Delete_Click" ToolTip="{l:T Packages_DeleteTip}">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
