<UserControl x:Class="J365.IntunePSApp.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization"
             xmlns:v="clr-namespace:J365.IntunePSApp.Views"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <UserControl.Resources>
    <v:PathNameConverter x:Key="PathName"/>
    <Style x:Key="Multi" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="MinHeight" Value="72"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,6,28,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="HeaderAvatar" Width="54" Height="54" CornerRadius="14" Background="{StaticResource Navy}">
        <Grid>
          <TextBlock x:Name="HeaderInitials" Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
          <Image x:Name="HeaderIcon" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderTitle" Style="{StaticResource PageTitle}" FontSize="24" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="HeaderSub" Style="{StaticResource MutedText}" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource GhostButton}" Click="New_Click" ToolTip="{l:T Ed_NewTip}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Ed_New}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Click="OpenProject_Click" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Ed_OpenProject}"/></StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Click="SaveProject_Click" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="{l:T Ed_SaveProject}"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Steps -->
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="24" Padding="5" Margin="0,16,0,14" HorizontalAlignment="Left">
      <StackPanel x:Name="Stepper" Orientation="Horizontal">
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="0" Content="{l:T Step_1}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="1" Content="{l:T Step_2}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="2" Content="{l:T Step_3}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="3" Content="{l:T Step_4}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="4" Content="{l:T Step_5}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="5" Content="{l:T Step_6}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="6" Content="{l:T Step_7}" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="7" Content="{l:T Step_8}" Checked="Step_Checked"/>
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <Grid MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,0,16">

          <!-- 1. Installer -->
          <StackPanel x:Name="Step0">
            <Border x:Name="UpdateBanner" Style="{StaticResource Notice}" Margin="0,0,0,14" Visibility="Collapsed">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="14,7" VerticalAlignment="Center" Margin="16,0,0,0" Click="UpdateInstaller_Click" Content="{l:T Ed_UpdateInstaller}"/>
                <TextBlock DockPanel.Dock="Left" Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" FontSize="18" Margin="2,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="UpdateBannerTitle" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                  <TextBlock Text="{l:T Ed_UpdateBannerText}" Foreground="{StaticResource Ink2}" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border x:Name="DropZone" Background="White" CornerRadius="14" Height="186" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
              <Grid>
                <Rectangle x:Name="DropRect" StrokeDashArray="6 4" Stroke="#94A3B8" StrokeThickness="1.6" RadiusX="14" RadiusY="14"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BrandSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="DropText" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                  <TextBlock Text="{l:T Ed_DropHint}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Style="{StaticResource SecondaryButton}" Click="Browse_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_BrowseFile}"/></StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="GoCatalog_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_PickCatalog}"/></StackPanel>
              </Button>
            </StackPanel>

            <Border x:Name="AnalysisCard" Style="{StaticResource Section}" Margin="0,16,0,16" Visibility="Collapsed">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SuccessSoft}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="AnalysisTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="AnalysisFile" Style="{StaticResource MutedText}" Margin="38,2,0,0" TextTrimming="CharacterEllipsis"/>
                <WrapPanel x:Name="AnalysisChips" Margin="0,14,0,4"/>
                <ItemsControl x:Name="AnalysisNotes" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Brand}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <CheckBox x:Name="ChkIncludeFolder" Style="{StaticResource Switch}" Content="{l:T Ed_IncludeFolder}" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- 2. Application -->
          <StackPanel x:Name="Step1" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_AppData}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_AppDataHint}" Style="{StaticResource MutedText}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{l:T Ed_AppName}" Style="{StaticResource Label}"/><TextBox x:Name="TxtName" TextChanged="Preview_Changed"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{l:T Ed_Vendor}" Style="{StaticResource Label}"/><TextBox x:Name="TxtVendor"/></StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{l:T Ed_Version}" Style="{StaticResource Label}"/><TextBox x:Name="TxtVersion" TextChanged="Preview_Changed"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{l:T Ed_Arch}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbArch" SelectionChanged="Arch_Changed">
                      <ComboBoxItem Tag="" Content="{l:T Opt_ArchAny}"/>
                      <ComboBoxItem Tag="x64" Content="{l:T Opt_ArchX64}"/>
                      <ComboBoxItem Tag="x86" Content="{l:T Opt_ArchX86}"/>
                      <ComboBoxItem Tag="arm64" Content="ARM64"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{l:T Ed_InstallArgs}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtInstallArgs" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="InstallArgsHint" Style="{StaticResource Hint}"/>
                <TextBlock Text="{l:T Ed_InstallFor}" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbBehavior">
                  <ComboBoxItem Tag="System" Content="{l:T Opt_BehaviorSystem}"/>
                  <ComboBoxItem Tag="User" Content="{l:T Opt_BehaviorUser}"/>
                </ComboBox>
                <TextBlock Text="{l:T Ed_Processes}" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtProcesses" TextChanged="Preview_Changed"/>
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{l:T Ed_PickRunning}" Margin="8,0,0,0" Click="PickProcess_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_ProcessesHint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_IntuneInfo}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_Description}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource Multi}" MinHeight="54"/>
                <TextBlock Text="{l:T Ed_Homepage}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtHomepage"/>
                <TextBlock Text="{l:T Ed_MinOs}" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbMinOs" Width="260" HorizontalAlignment="Left"/>
                <TextBlock Text="{l:T Ed_MinOsHint}" Style="{StaticResource Hint}"/>
                <CheckBox x:Name="ChkWaitChildren" Style="{StaticResource Switch}" Content="{l:T Ed_WaitChildren}" Margin="0,16,0,0"/>
                <TextBlock Text="{l:T Ed_ExtraCodes}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtExtraCodes" Width="240" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_ExtraCodesHint}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 3. Experience -->
          <StackPanel x:Name="Step2" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Settings_Mode}" Style="{StaticResource H2}"/>
                <ComboBox x:Name="CmbMode" Margin="0,12,0,0" SelectionChanged="Mode_Changed">
                  <ComboBoxItem Tag="Auto" Content="{l:T Opt_ModeAutoLong}"/>
                  <ComboBoxItem Tag="Silent" Content="{l:T Opt_ModeSilentLong}"/>
                  <ComboBoxItem Tag="Interactive" Content="{l:T Opt_ModeInteractiveLong}"/>
                </ComboBox>
                <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_CloseDefer}" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox x:Name="ChkDefer" Style="{StaticResource Switch}" Content="{l:T Ed_DeferUpTo}" Margin="0,4,0,0" Checked="Preview_Changed" Unchecked="Preview_Changed"/>
                  <TextBox x:Name="TxtDeferTimes" Width="64" Margin="10,0,8,0" HorizontalContentAlignment="Center" TextChanged="Preview_Changed"/>
                  <TextBlock Text="{l:T Ed_Times}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="{l:T Ed_CloseAfter}" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtCountdown" Width="76" Margin="10,0,8,0" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="{l:T Ed_Seconds}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_CountdownHint}"/>
                <CheckBox x:Name="ChkBlock" Style="{StaticResource Switch}" Content="{l:T Opt_BlockExecution}" Margin="0,14,0,0"/>
                <CheckBox x:Name="ChkDisk" Style="{StaticResource Switch}" Content="{l:T Opt_CheckDisk}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Messages}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_MsgWelcome}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtWelcome" Style="{StaticResource Multi}" TextChanged="Preview_Changed"/>
                <TextBlock Text="{l:T Ed_MsgProgress}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtProgress"/>
                <TextBlock Text="{l:T Ed_MsgDone}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtCompletion" Style="{StaticResource Multi}" MinHeight="56" TextChanged="Preview_Changed"/>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_MessagesHint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Restart}" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox x:Name="ChkRestart" Style="{StaticResource Switch}" Content="{l:T Ed_RestartPrompt}" Margin="0,4,0,0"/>
                  <TextBox x:Name="TxtRestart" Width="76" Margin="10,0,8,0" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="{l:T Ed_Seconds}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 4. Actions -->
          <StackPanel x:Name="Step3" Visibility="Collapsed">
            <Border x:Name="DependenciesCard" Style="{StaticResource Section}" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Dependencies}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_DependenciesHint}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <ItemsControl x:Name="DependencyList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,6" VerticalAlignment="Center" Margin="12,0,0,0" Tag="{Binding}" Click="IncludeDependency_Click"
                                  Content="{l:T Ed_IncludeDependency}" Visibility="{Binding CanInclude, Converter={StaticResource BoolToVis}}"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                          <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Background="{StaticResource BrandSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="AddAction_Click" Padding="16,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T ActionDlg_TitleAdd}"/></StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="{l:T Ed_Actions}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{l:T Ed_ActionsHint}" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{l:T Ed_Quick}" Style="{StaticResource Overline}" Margin="0,18,0,8"/>
                <WrapPanel x:Name="QuickActions"/>
                <TextBlock x:Name="ActionsEmpty" Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="{l:T Ed_ActionsEmpty}"/>
                <ItemsControl x:Name="ActionsList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource BrandSoft}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource H3}"/>
                              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,1"><TextBlock Text="{Binding PhaseLabel}" FontSize="11.5" Foreground="{StaticResource Brand}"/></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" ToolTip="{l:T Ed_MoveUp}" Tag="{Binding}" Click="ActionUp_Click"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{l:T Ed_MoveDown}" Tag="{Binding}" Click="ActionDown_Click"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{l:T Ed_Edit}" Tag="{Binding}" Click="ActionEdit_Click"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="{l:T Common_Remove}" Tag="{Binding}" Click="ActionDelete_Click"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Danger}"/></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="{l:T Ed_AddFiles}" Click="AddExtraFile_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{l:T Ed_AddFolder}" Margin="8,0,0,0" Click="AddExtraFolder_Click"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{l:T Ed_ExtraFiles}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{l:T Ed_ExtraFilesHint}" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
                <ListBox x:Name="ExtraFilesList" Margin="0,12,0,0" MaxHeight="160" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel ToolTip="{Binding}">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Brand}" Margin="0,0,10,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Converter={StaticResource PathName}}" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Style="{StaticResource GhostButton}" Content="{l:T Ed_RemoveSelected}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RemoveExtra_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 5. Uninstall -->
          <StackPanel x:Name="Step4" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Uninstall}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_UninstallHint}" Style="{StaticResource MutedText}"/>
                <CheckBox x:Name="ChkRemovePrev" Style="{StaticResource Switch}" Content="{l:T Ed_RemovePrev}" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock Text="{l:T Ed_ProgramName}" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtPattern"/>
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{l:T Ed_ShowMatches}" Margin="8,0,0,0" Click="ShowInstalled_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_PatternHint}"/>
                <ListView x:Name="InstalledList" Margin="0,12,0,0" MaxHeight="200" Visibility="Collapsed">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="{l:T Ed_ColProgram}" Width="260" DisplayMemberBinding="{Binding Name}"/>
                      <GridViewColumn Header="{l:T Ed_Version}" Width="110" DisplayMemberBinding="{Binding Version}"/>
                      <GridViewColumn Header="{l:T Catalog_ColType}" Width="56" DisplayMemberBinding="{Binding Type}"/>
                      <GridViewColumn Header="{l:T Ed_ColSilentRemoval}" Width="150" DisplayMemberBinding="{Binding SilentLabel}"/>
                      <GridViewColumn Header="{l:T Catalog_ColScope}" Width="150" DisplayMemberBinding="{Binding Scope}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
                <TextBlock x:Name="InstalledInfo" Style="{StaticResource Hint}"/>
                <TextBlock Text="{l:T Ed_UninstallArgs}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtUninstallArgs" Style="{StaticResource Mono}"/>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_UninstallArgsHint}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 6. Detection -->
          <StackPanel x:Name="Step5" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Detection}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_DetectionHint}" Style="{StaticResource MutedText}"/>
                <RadioButton x:Name="RbDetName" GroupName="det" Content="{l:T Ed_DetByName}" Margin="0,14,0,0" Checked="Det_Changed"/>
                <RadioButton x:Name="RbDetCode" GroupName="det" Content="{l:T Ed_DetByCode}" Margin="0,8,0,0" Checked="Det_Changed"/>
                <RadioButton x:Name="RbDetFile" GroupName="det" Content="{l:T Ed_DetByFile}" Margin="0,8,0,0" Checked="Det_Changed"/>
                <StackPanel x:Name="PnlDetName">
                  <TextBlock Text="{l:T Ed_DetName}" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetName"/>
                </StackPanel>
                <StackPanel x:Name="PnlDetCode">
                  <TextBlock Text="{l:T Ed_DetCode}" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetCode" Style="{StaticResource Mono}"/>
                </StackPanel>
                <StackPanel x:Name="PnlDetFile">
                  <TextBlock Text="{l:T Ed_DetFile}" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetFile"/>
                  <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_DetFileHint}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <CheckBox x:Name="ChkDetVersion" Style="{StaticResource Switch}" Content="{l:T Ed_DetVersion}" Margin="0,4,0,0" Checked="Det_Changed" Unchecked="Det_Changed"/>
                  <TextBox x:Name="TxtDetVersion" Width="180" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Click="TestDetection_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_TestHere}"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ViewDetection_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_ViewScript}"/></StackPanel>
                  </Button>
                </StackPanel>
                <Border x:Name="DetResult" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="DetResultText" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 7. Branding -->
          <StackPanel x:Name="Step6" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Settings_Company}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_BrandingHint}" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{l:T Settings_CompanyName}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtCompany" TextChanged="Preview_Changed"/>
                <TextBlock Text="{l:T Settings_Logo}" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" Background="{StaticResource Subtle}">
                    <Image x:Name="LogoThumb" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <TextBox x:Name="TxtLogo" Grid.Column="1" TextChanged="Logo_Changed"/>
                  <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{l:T Common_Browse}" Margin="8,0,0,0" Click="Logo_Click"/>
                  <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="{l:T Common_Remove}" Margin="4,0,0,0" Click="LogoClear_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{l:T Ed_LogoHint}"/>
                <TextBlock Text="{l:T Ed_Accent}" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="TxtAccent" Width="110" Style="{StaticResource Mono}" TextChanged="Preview_Changed"/>
                  <Border x:Name="AccentSwatch" Width="34" Height="34" CornerRadius="8" Margin="10,0,16,0" BorderBrush="{StaticResource Line2}" BorderThickness="1"/>
                  <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{l:T Settings_DialogStyle}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbStyle">
                      <ComboBoxItem Tag="Fluent" Content="{l:T Opt_StyleFluent}"/>
                      <ComboBoxItem Tag="Classic" Content="{l:T Opt_StyleClassic}"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="{l:T Settings_DialogLanguage}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbLanguage">
                      <ComboBoxItem Tag="Auto" Content="{l:T Opt_LangAuto}"/>
                      <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/>
                      <ComboBoxItem Tag="en" Content="English"/>
                      <ComboBoxItem Tag="es" Content="Español"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="ChkImeLogs" Style="{StaticResource Switch}" Content="{l:T Settings_ImeLogs}" Margin="0,16,0,0"/>
                <TextBlock Text="{l:T Settings_Author}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtAuthor"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Click="SaveCompany_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_SaveCompany}"/></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 8. Generate -->
          <StackPanel x:Name="Step7" Visibility="Collapsed">
            <Border x:Name="ResultCard" Style="{StaticResource Section}" Visibility="Collapsed" BorderBrush="#9AD7B0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SuccessSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T Ed_ResultTitle}" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ResultFile" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="ResultHash" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  </StackPanel>
                </StackPanel>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="{l:T Sum_F_InstallCmd}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ResultInstall" Grid.Column="1" IsReadOnly="True" Style="{StaticResource Mono}" Margin="0,3"/>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="{l:T Common_Copy}" Tag="install" Click="Copy_Click" Margin="6,0,0,0"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                  <TextBlock Grid.Row="1" Text="{l:T Sum_F_UninstallCmd}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ResultUninstall" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Style="{StaticResource Mono}" Margin="0,3"/>
                  <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="{l:T Common_Copy}" Tag="uninstall" Click="Copy_Click" Margin="6,0,0,0"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                </Grid>
                <WrapPanel Margin="0,16,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T Common_OpenFolder}"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="OpenInstructions_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_Instructions}"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="TestInstall_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_TestInstall}"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="TestUninstall_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_TestUninstall}"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnSandbox" Style="{StaticResource SecondaryButton}" Click="Sandbox_Click" Margin="0,0,8,8" ToolTip="{l:T Ed_SandboxTip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_Sandbox}"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnPublish" Style="{StaticResource SecondaryButton}" Click="Publish_Click" Margin="0,0,8,8" ToolTip="{l:T Ed_PublishTip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_Publish}"/></StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="{l:T Ed_Review}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T Ed_ReviewHint}" Style="{StaticResource MutedText}"/>
                <ItemsControl x:Name="SummaryList" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Item1}" Style="{StaticResource MutedText}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Item2}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="ValidationList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Item1}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Item2}" Foreground="{Binding Item3}" TextWrapping="Wrap"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="BtnGenerate2" Style="{StaticResource PrimaryButton}" Padding="26,11" FontSize="14.5" Click="Generate_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0"/><TextBlock Text="{l:T Ed_Generate}"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PreviewScript_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_PreviewScript}"/></StackPanel>
                  </Button>
                  <CheckBox x:Name="ChkNative" Style="{StaticResource Switch}" Content="{l:T Ed_Native}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="LogCard" Style="{StaticResource Section}" Visibility="Collapsed">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="BtnCancelBuild" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T Common_Cancel}" Click="CancelBuild_Click" Visibility="Collapsed"/>
                  <TextBlock x:Name="LogTitle" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar x:Name="BuildProgress" Height="5" Margin="0,10,0,10" IsIndeterminate="True"/>
                <ItemsControl x:Name="LogList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Ink2}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Preview -->
      <Border x:Name="PreviewPanel" Grid.Column="1" Width="370" Margin="16,0,0,16" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{l:T Ed_PreviewOverline}" Style="{StaticResource Overline}"/>
            <TextBlock Text="{l:T Ed_PreviewHint}" Style="{StaticResource Hint}" Margin="0,2,0,12"/>
            <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Effect="{StaticResource CardShadow}">
              <StackPanel>
                <Grid Margin="18,16,18,0">
                  <Image x:Name="PrevLogo" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel Margin="52,0,0,0">
                    <TextBlock x:Name="PrevTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="PrevSubtitle" Style="{StaticResource MutedText}" FontSize="12"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="PrevBody" Margin="18,14,18,0" Style="{StaticResource Body}"/>
                <Border x:Name="PrevAppsBox" Margin="18,10,18,0" Background="{StaticResource Subtle}" CornerRadius="7" Padding="10,8">
                  <TextBlock x:Name="PrevApps" Style="{StaticResource Body}"/>
                </Border>
                <TextBlock x:Name="PrevCustom" Margin="18,10,18,0" Style="{StaticResource Body}" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="PrevDefer" Margin="18,10,18,0" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,18">
                  <Border x:Name="PrevDeferBtn" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="5" Padding="12,6"><TextBlock Text="{l:T Prev_Defer}"/></Border>
                  <Border x:Name="PrevMainBtn" CornerRadius="5" Padding="12,6" Margin="8,0,0,0" Background="{StaticResource Brand}"><TextBlock x:Name="PrevMainText" Foreground="White"/></Border>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PrevDoneLabel" Text="{l:T Ed_PreviewDone}" Style="{StaticResource Overline}" Margin="0,20,0,8"/>
            <Border x:Name="PrevDoneBox" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="16,12">
              <StackPanel>
                <TextBlock x:Name="PrevDone" Style="{StaticResource Body}"/>
                <Border x:Name="PrevOkBtn" CornerRadius="5" Padding="16,5" HorizontalAlignment="Right" Margin="0,12,0,0" Background="{StaticResource Brand}"><TextBlock Text="OK" Foreground="White"/></Border>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PrevNote" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="BtnBack" Style="{StaticResource SecondaryButton}" Click="Back_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{l:T Ed_Back}"/></StackPanel>
          </Button>
          <Button x:Name="BtnNext" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Next_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{l:T Ed_Next}"/><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnGenerate" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Generate_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="BtnGenerateText"/></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="FooterInfo" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
