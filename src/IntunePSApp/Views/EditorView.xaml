<UserControl x:Class="J365.IntunePSApp.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <UserControl.Resources>
    <Style x:Key="Multi" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="MinHeight" Value="72"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="28,6,28,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Cabecalho -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="HeaderAvatar" Width="54" Height="54" CornerRadius="14" Background="{StaticResource Navy}">
        <Grid>
          <TextBlock x:Name="HeaderInitials" Text="&#xE7B8;" Style="{StaticResource Icon}" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
          <Image x:Name="HeaderIcon" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderTitle" Text="Novo pacote" Style="{StaticResource PageTitle}" FontSize="24" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="HeaderSub" Text="Arraste um instalador ou escolha um aplicativo no catálogo." Style="{StaticResource MutedText}" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource GhostButton}" Click="New_Click" ToolTip="Começar um pacote novo">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Novo"/></StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Click="OpenProject_Click" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Abrir projeto"/></StackPanel>
        </Button>
        <Button Style="{StaticResource GhostButton}" Click="SaveProject_Click" Margin="4,0,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Salvar projeto"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Etapas -->
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="24" Padding="5" Margin="0,16,0,14" HorizontalAlignment="Left">
      <StackPanel x:Name="Stepper" Orientation="Horizontal">
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="0" Content="1  Instalador" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="1" Content="2  Aplicativo" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="2" Content="3  Experiência" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="3" Content="4  Ações" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="4" Content="5  Desinstalação" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="5" Content="6  Detecção" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="6" Content="7  Visual" Checked="Step_Checked"/>
        <RadioButton Style="{StaticResource StepItem}" GroupName="step" Tag="7" Content="8  Gerar" Checked="Step_Checked"/>
      </StackPanel>
    </Border>

    <!-- Corpo -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <Grid MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,0,16">

          <!-- 1. Instalador -->
          <StackPanel x:Name="Step0">
            <Border x:Name="DropZone" Background="White" CornerRadius="14" Height="186" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
              <Grid>
                <Rectangle x:Name="DropRect" StrokeDashArray="6 4" Stroke="#94A3B8" StrokeThickness="1.6" RadiusX="14" RadiusY="14"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource BrandSoft}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="24" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="DropText" Text="Arraste o instalador (.msi ou .exe) aqui ou clique para procurar" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                  <TextBlock Text="O aplicativo é identificado pelo hash, código do produto ou nome no banco de dados." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Style="{StaticResource SecondaryButton}" Click="Browse_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Procurar arquivo..."/></StackPanel>
              </Button>
              <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="GoCatalog_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Escolher no catálogo"/></StackPanel>
              </Button>
            </StackPanel>

            <Border x:Name="AnalysisCard" Style="{StaticResource Section}" Margin="0,16,0,16" Visibility="Collapsed">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SuccessSoft}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="AnalysisTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="AnalysisFile" Style="{StaticResource MutedText}" Margin="38,2,0,0" TextTrimming="CharacterEllipsis"/>
                <WrapPanel x:Name="AnalysisChips" Margin="0,14,0,4"/>
                <ItemsControl x:Name="AnalysisNotes" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Brand}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <CheckBox x:Name="ChkIncludeFolder" Style="{StaticResource Switch}" Content="Incluir todos os arquivos da pasta do instalador (para instaladores que usam .cab, .mst ou arquivos de configuração)" Margin="0,4,0,0"/>
          </StackPanel>

          <!-- 2. Aplicativo -->
          <StackPanel x:Name="Step1" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Dados do aplicativo" Style="{StaticResource H2}"/>
                <TextBlock Text="Preenchidos automaticamente. Revise se necessário." Style="{StaticResource MutedText}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Nome do aplicativo" Style="{StaticResource Label}"/><TextBox x:Name="TxtName" TextChanged="Preview_Changed"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Fabricante" Style="{StaticResource Label}"/><TextBox x:Name="TxtVendor"/></StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Versão" Style="{StaticResource Label}"/><TextBox x:Name="TxtVersion" TextChanged="Preview_Changed"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Arquitetura" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbArch">
                      <ComboBoxItem Tag="" Content="Qualquer (32 e 64 bits)"/>
                      <ComboBoxItem Tag="x64" Content="64 bits (x64)"/>
                      <ComboBoxItem Tag="x86" Content="32 bits (x86)"/>
                      <ComboBoxItem Tag="arm64" Content="ARM64"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Parâmetros de instalação silenciosa" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtInstallArgs" Style="{StaticResource Mono}"/>
                <TextBlock x:Name="InstallArgsHint" Style="{StaticResource Hint}"/>
                <TextBlock Text="Instalar para" Style="{StaticResource Label}"/>
                <ComboBox x:Name="CmbBehavior">
                  <ComboBoxItem Tag="System" Content="Todo o computador — contexto Sistema (recomendado)"/>
                  <ComboBoxItem Tag="User" Content="Somente o usuário conectado — contexto Usuário"/>
                </ComboBox>
                <TextBlock Text="Aplicativos que precisam estar fechados" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtProcesses" TextChanged="Preview_Changed"/>
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Escolher em execução..." Margin="8,0,0,0" Click="PickProcess_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Executáveis separados por vírgula, sem .exe (ex.: 7zFM, 7zG). Se algum estiver aberto, o usuário é avisado e pode fechar ou adiar."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Informações para o Intune e opções avançadas" Style="{StaticResource H2}"/>
                <TextBlock Text="Descrição" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource Multi}" MinHeight="54"/>
                <TextBlock Text="Site do aplicativo" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtHomepage"/>
                <CheckBox x:Name="ChkWaitChildren" Style="{StaticResource Switch}" Content="Aguardar os processos filhos do instalador (instaladores que iniciam outro instalador e fecham)" Margin="0,16,0,0"/>
                <TextBlock Text="Códigos de saída adicionais considerados sucesso" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtExtraCodes" Width="240" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Text="Ex.: 1707, 2. Os códigos 0, 1641 e 3010 já são tratados."/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 3. Experiencia -->
          <StackPanel x:Name="Step2" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Modo de exibição" Style="{StaticResource H2}"/>
                <ComboBox x:Name="CmbMode" Margin="0,12,0,0" SelectionChanged="Mode_Changed">
                  <ComboBoxItem Tag="Auto" Content="Automático (recomendado) — janelas apenas quando necessário"/>
                  <ComboBoxItem Tag="Silent" Content="Silencioso — nunca mostra janelas"/>
                  <ComboBoxItem Tag="Interactive" Content="Interativo — sempre mostra as janelas"/>
                </ComboBox>
                <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Fechar aplicativos e adiar" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox x:Name="ChkDefer" Style="{StaticResource Switch}" Content="Permitir adiar até" Margin="0,4,0,0" Checked="Preview_Changed" Unchecked="Preview_Changed"/>
                  <TextBox x:Name="TxtDeferTimes" Width="64" Margin="10,0,8,0" HorizontalContentAlignment="Center" TextChanged="Preview_Changed"/>
                  <TextBlock Text="vez(es)" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Fechar os aplicativos automaticamente após" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtCountdown" Width="76" Margin="10,0,8,0" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="segundos" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="0 = aguardar o usuário. A contagem vale quando não é possível adiar ou quando os adiamentos acabaram."/>
                <CheckBox x:Name="ChkBlock" Style="{StaticResource Switch}" Content="Impedir que o usuário abra o aplicativo durante a instalação" Margin="0,14,0,0"/>
                <CheckBox x:Name="ChkDisk" Style="{StaticResource Switch}" Content="Verificar se há espaço em disco suficiente"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Mensagens personalizadas" Style="{StaticResource H2}"/>
                <TextBlock Text="Mensagem na janela de boas-vindas" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtWelcome" Style="{StaticResource Multi}" TextChanged="Preview_Changed"/>
                <TextBlock Text="Mensagem durante a instalação" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtProgress"/>
                <TextBlock Text="Mensagem ao concluir" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtCompletion" Style="{StaticResource Multi}" MinHeight="56" TextChanged="Preview_Changed"/>
                <TextBlock Style="{StaticResource Hint}" Text="Em branco: usa o texto padrão do PSADT (ou não mostra a mensagem final)."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Reinicialização" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <CheckBox x:Name="ChkRestart" Style="{StaticResource Switch}" Content="Pedir para reiniciar ao final; reinicia sozinho após" Margin="0,4,0,0"/>
                  <TextBox x:Name="TxtRestart" Width="76" Margin="10,0,8,0" HorizontalContentAlignment="Center"/>
                  <TextBlock Text="segundos" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 4. Acoes -->
          <StackPanel x:Name="Step3" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="AddAction_Click" Padding="16,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Adicionar ação"/></StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Text="Ações personalizadas" Style="{StaticResource H2}"/>
                    <TextBlock Text="Tarefas executadas antes ou depois da instalação/desinstalação — sem escrever script." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="SUGESTÕES RÁPIDAS" Style="{StaticResource Overline}" Margin="0,18,0,8"/>
                <WrapPanel x:Name="QuickActions"/>
                <TextBlock x:Name="ActionsEmpty" Style="{StaticResource MutedText}" Margin="0,14,0,0" Text="Nenhuma ação adicionada. As ações viram comandos do PSAppDeployToolkit no pacote."/>
                <ItemsControl x:Name="ActionsList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource BrandSoft}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Brand}" HorizontalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource H3}"/>
                              <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,1"><TextBlock Text="{Binding PhaseLabel}" FontSize="11.5" Foreground="{StaticResource Brand}"/></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" ToolTip="Mover para cima" Tag="{Binding}" Click="ActionUp_Click"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Mover para baixo" Tag="{Binding}" Click="ActionDown_Click"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Editar" Tag="{Binding}" Click="ActionEdit_Click"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Remover" Tag="{Binding}" Click="ActionDelete_Click"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Danger}"/></Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="Adicionar arquivos..." Click="AddExtraFile_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Adicionar pasta..." Margin="8,0,0,0" Click="AddExtraFolder_Click"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Arquivos extras" Style="{StaticResource H2}"/>
                    <TextBlock Text="Vão para a pasta SupportFiles do pacote (licenças, configurações, fontes...). Use as ações de cópia para instalá-los." Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </DockPanel>
                <ListBox x:Name="ExtraFilesList" Margin="0,12,0,0" MaxHeight="160" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                <Button Style="{StaticResource GhostButton}" Content="Remover selecionado" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RemoveExtra_Click"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 5. Desinstalacao -->
          <StackPanel x:Name="Step4" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Versões anteriores e desinstalação" Style="{StaticResource H2}"/>
                <TextBlock Text="O mesmo nome é usado para remover versões antigas antes de instalar e pelo comando de desinstalação do Intune." Style="{StaticResource MutedText}"/>
                <CheckBox x:Name="ChkRemovePrev" Style="{StaticResource Switch}" Content="Desinstalar qualquer versão já instalada antes de instalar a nova" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <TextBlock Text="Nome do programa em &quot;Aplicativos instalados&quot;" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtPattern"/>
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Ver correspondências neste PC" Margin="8,0,0,0" Click="ShowInstalled_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Use * como curinga: 7-Zip* encontra &quot;7-Zip 24.08 (x64)&quot; e &quot;7-Zip 26.06 (x64)&quot;. Evite nomes genéricos."/>
                <ListView x:Name="InstalledList" Margin="0,12,0,0" MaxHeight="200" Visibility="Collapsed">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Programa" Width="260" DisplayMemberBinding="{Binding Name}"/>
                      <GridViewColumn Header="Versão" Width="110" DisplayMemberBinding="{Binding Version}"/>
                      <GridViewColumn Header="Tipo" Width="56" DisplayMemberBinding="{Binding Type}"/>
                      <GridViewColumn Header="Remoção silenciosa" Width="150" DisplayMemberBinding="{Binding SilentLabel}"/>
                      <GridViewColumn Header="Escopo" Width="150" DisplayMemberBinding="{Binding Scope}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
                <TextBlock x:Name="InstalledInfo" Style="{StaticResource Hint}"/>
                <TextBlock Text="Parâmetros silenciosos do desinstalador (.exe)" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtUninstallArgs" Style="{StaticResource Mono}"/>
                <TextBlock Style="{StaticResource Hint}" Text="MSI é removido automaticamente (msiexec /x). Para .exe informe o parâmetro (ex.: /S, /VERYSILENT). Em branco: remove apenas programas com desinstalação silenciosa registrada."/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 6. Deteccao -->
          <StackPanel x:Name="Step5" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Como o Intune sabe que o aplicativo está instalado" Style="{StaticResource H2}"/>
                <TextBlock Text="É gerado um script de detecção (Regras de detecção › Usar script personalizado)." Style="{StaticResource MutedText}"/>
                <RadioButton x:Name="RbDetName" GroupName="det" Content="Programa instalado, pelo nome (recomendado)" Margin="0,14,0,0" Checked="Det_Changed"/>
                <RadioButton x:Name="RbDetCode" GroupName="det" Content="Código do produto / chave de desinstalação" Margin="0,8,0,0" Checked="Det_Changed"/>
                <RadioButton x:Name="RbDetFile" GroupName="det" Content="Arquivo no disco" Margin="0,8,0,0" Checked="Det_Changed"/>
                <StackPanel x:Name="PnlDetName">
                  <TextBlock Text="Nome do programa" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetName"/>
                </StackPanel>
                <StackPanel x:Name="PnlDetCode">
                  <TextBlock Text="Código do produto (MSI) ou nome da chave de desinstalação" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetCode" Style="{StaticResource Mono}"/>
                </StackPanel>
                <StackPanel x:Name="PnlDetFile">
                  <TextBlock Text="Caminho do arquivo" Style="{StaticResource Label}"/>
                  <TextBox x:Name="TxtDetFile"/>
                  <TextBlock Style="{StaticResource Hint}" Text="Aceita variáveis de ambiente: %ProgramFiles%\7-Zip\7zFM.exe"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <CheckBox x:Name="ChkDetVersion" Style="{StaticResource Switch}" Content="Exigir versão igual ou superior a" Margin="0,4,0,0" Checked="Det_Changed" Unchecked="Det_Changed"/>
                  <TextBox x:Name="TxtDetVersion" Width="180" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Click="TestDetection_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Testar neste computador"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ViewDetection_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Ver o script"/></StackPanel>
                  </Button>
                </StackPanel>
                <Border x:Name="DetResult" CornerRadius="10" Padding="14,10" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="DetResultText" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 7. Visual -->
          <StackPanel x:Name="Step6" Visibility="Collapsed">
            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Identidade visual da empresa" Style="{StaticResource H2}"/>
                <TextBlock Text="Aparece nas janelas do PSAppDeployToolkit. Salve como padrão para todos os pacotes." Style="{StaticResource MutedText}"/>
                <TextBlock Text="Nome da empresa" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtCompany" TextChanged="Preview_Changed"/>
                <TextBlock Text="Logo" Style="{StaticResource Label}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,10,0" Background="{StaticResource Subtle}">
                    <Image x:Name="LogoThumb" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Border>
                  <TextBox x:Name="TxtLogo" Grid.Column="1" TextChanged="Logo_Changed"/>
                  <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Procurar..." Margin="8,0,0,0" Click="Logo_Click"/>
                  <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Remover" Margin="4,0,0,0" Click="LogoClear_Click"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="PNG, JPG ou ICO. Ideal: quadrado, fundo transparente, 256×256 ou maior."/>
                <TextBlock Text="Cor de destaque dos botões" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="TxtAccent" Width="110" Style="{StaticResource Mono}" TextChanged="Preview_Changed"/>
                  <Border x:Name="AccentSwatch" Width="34" Height="34" CornerRadius="8" Margin="10,0,16,0" BorderBrush="{StaticResource Line2}" BorderThickness="1"/>
                  <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Estilo das janelas" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbStyle">
                      <ComboBoxItem Tag="Fluent" Content="Moderno (Fluent, Windows 11)"/>
                      <ComboBoxItem Tag="Classic" Content="Clássico (PSADT 3)"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Idioma das janelas" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbLanguage">
                      <ComboBoxItem Tag="Auto" Content="Automático (idioma do Windows)"/>
                      <ComboBoxItem Tag="pt-BR" Content="Português (Brasil)"/>
                      <ComboBoxItem Tag="en" Content="English"/>
                      <ComboBoxItem Tag="es" Content="Español"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="ChkImeLogs" Style="{StaticResource Switch}" Content="Gravar os logs na pasta do Intune (coletados pelo &quot;Coletar diagnóstico&quot;)" Margin="0,16,0,0"/>
                <TextBlock Text="Autor do pacote" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtAuthor"/>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Click="SaveCompany_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Salvar como padrão da empresa"/></StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 8. Gerar -->
          <StackPanel x:Name="Step7" Visibility="Collapsed">
            <Border x:Name="ResultCard" Style="{StaticResource Section}" Visibility="Collapsed" BorderBrush="#9AD7B0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SuccessSoft}" Margin="0,0,12,0">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource Success}" HorizontalAlignment="Center"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pacote pronto para o Intune" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ResultFile" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                </StackPanel>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="Comando de instalação" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ResultInstall" Grid.Column="1" IsReadOnly="True" Style="{StaticResource Mono}" Margin="0,3"/>
                  <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copiar" Tag="install" Click="Copy_Click" Margin="6,0,0,0"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                  <TextBlock Grid.Row="1" Text="Comando de desinstalação" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                  <TextBox x:Name="ResultUninstall" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Style="{StaticResource Mono}" Margin="0,3"/>
                  <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Copiar" Tag="uninstall" Click="Copy_Click" Margin="6,0,0,0"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/></Button>
                </Grid>
                <WrapPanel Margin="0,16,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="Abrir pasta"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="OpenInstructions_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Instruções do Intune"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="TestInstall_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Testar instalação"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Click="TestUninstall_Click" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Testar desinstalação"/></StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
              <StackPanel>
                <TextBlock Text="Revisar e gerar" Style="{StaticResource H2}"/>
                <TextBlock Text="Confira o resumo. O pacote é validado antes de ser gerado." Style="{StaticResource MutedText}"/>
                <ItemsControl x:Name="SummaryList" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Item1}" Style="{StaticResource MutedText}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Item2}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="ValidationList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Item1}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Item2}" Foreground="{Binding Item3}" TextWrapping="Wrap"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="BtnGenerate2" Style="{StaticResource PrimaryButton}" Padding="26,11" FontSize="14.5" Click="Generate_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0"/><TextBlock Text="Gerar pacote"/></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="PreviewScript_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Pré-visualizar script"/></StackPanel>
                  </Button>
                  <CheckBox x:Name="ChkNative" Style="{StaticResource Switch}" Content="Usar empacotador interno (sem IntuneWinAppUtil)" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="LogCard" Style="{StaticResource Section}" Visibility="Collapsed">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="LogTitle" Text="Progresso" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar x:Name="BuildProgress" Height="5" Margin="0,10,0,10" IsIndeterminate="True"/>
                <ItemsControl x:Name="LogList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{Binding Color}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Ink2}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Previa -->
      <Border x:Name="PreviewPanel" Grid.Column="1" Width="370" Margin="16,0,0,16" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="PRÉVIA" Style="{StaticResource Overline}"/>
            <TextBlock Text="Aproximação da janela que o usuário verá." Style="{StaticResource Hint}" Margin="0,2,0,12"/>
            <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Effect="{StaticResource CardShadow}">
              <StackPanel>
                <Grid Margin="18,16,18,0">
                  <Image x:Name="PrevLogo" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel Margin="52,0,0,0">
                    <TextBlock x:Name="PrevTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="PrevSubtitle" Style="{StaticResource MutedText}" FontSize="12"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="PrevBody" Margin="18,14,18,0" Style="{StaticResource Body}"/>
                <Border x:Name="PrevAppsBox" Margin="18,10,18,0" Background="{StaticResource Subtle}" CornerRadius="7" Padding="10,8">
                  <TextBlock x:Name="PrevApps" Style="{StaticResource Body}"/>
                </Border>
                <TextBlock x:Name="PrevCustom" Margin="18,10,18,0" Style="{StaticResource Body}" Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="PrevDefer" Margin="18,10,18,0" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,16,18,18">
                  <Border x:Name="PrevDeferBtn" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="5" Padding="12,6"><TextBlock Text="Adiar"/></Border>
                  <Border x:Name="PrevMainBtn" CornerRadius="5" Padding="12,6" Margin="8,0,0,0" Background="{StaticResource Brand}"><TextBlock x:Name="PrevMainText" Foreground="White"/></Border>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PrevDoneLabel" Text="AO CONCLUIR" Style="{StaticResource Overline}" Margin="0,20,0,8"/>
            <Border x:Name="PrevDoneBox" Background="White" CornerRadius="10" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="16,12">
              <StackPanel>
                <TextBlock x:Name="PrevDone" Style="{StaticResource Body}"/>
                <Border x:Name="PrevOkBtn" CornerRadius="5" Padding="16,5" HorizontalAlignment="Right" Margin="0,12,0,0" Background="{StaticResource Brand}"><TextBlock Text="OK" Foreground="White"/></Border>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PrevNote" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Rodape -->
    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="BtnBack" Style="{StaticResource SecondaryButton}" Click="Back_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="Voltar"/></StackPanel>
          </Button>
          <Button x:Name="BtnNext" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Next_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="Próximo"/><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="12" Margin="8,0,0,0"/></StackPanel>
          </Button>
          <Button x:Name="BtnGenerate" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="Generate_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="BtnGenerateText" Text="Gerar pacote"/></StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="FooterInfo" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
