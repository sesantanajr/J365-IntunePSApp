<v:DialogWindow x:Class="J365.IntunePSApp.Views.BatchWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:J365.IntunePSApp.Localization"
                xmlns:v="clr-namespace:J365.IntunePSApp.Views"
                Title="J365 IntunePSApp" Width="1120" Height="780" MinWidth="760" MinHeight="520">
  <v:DialogWindow.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="StateText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Foreground" Value="{DynamicResource Brand}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Analyzing"><Setter Property="Foreground" Value="{DynamicResource Brand}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Building"><Setter Property="Foreground" Value="{DynamicResource Brand}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Skipped"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Publishing"><Setter Property="Foreground" Value="{DynamicResource Brand}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Published"><Setter Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="PublishFailed"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </v:DialogWindow.Resources>

  <Grid Margin="28,22,28,22">
    <!-- Header, then the settings (left, scrolling on their own) beside the applications (right), then the actions:
         the list and the buttons stay visible on any screen (1366x768 at 125 % included). -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel>
      <Border Style="{StaticResource IconTile}" Width="50" Height="50" CornerRadius="15" VerticalAlignment="Top">
        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" TextWrapping="Wrap"/>
        <TextBlock Text="{l:T Batch_Intro}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,18,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="11*" MinWidth="340"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="10*" MinWidth="260"/>
      </Grid.ColumnDefinitions>

    <!-- Settings shared by every package -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
    <Border x:Name="SettingsCard" Style="{StaticResource Card}" Padding="20,16">
      <StackPanel>
        <TextBlock Text="{l:T Batch_SharedTitle}" Style="{StaticResource H3}"/>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l:T Settings_CompanyName}" Style="{StaticResource Label}"/>
            <TextBox x:Name="TxtCompany"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{l:T Ed_Owner}" Style="{StaticResource Label}"/>
            <TextBox x:Name="TxtOwner"/>
          </StackPanel>
        </Grid>
        <Grid>
          <StackPanel>
            <TextBlock Text="{l:T Settings_Mode}" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmbMode" SelectionChanged="Mode_Changed">
              <ComboBoxItem Tag="Notify" Content="{l:T Opt_ModeNotifyLong}"/>
              <ComboBoxItem Tag="Silent" Content="{l:T Opt_ModeSilentLong}"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        <!-- What every package does with the copies already installed: "remove any version" reinstalls cleanly -->
        <TextBlock Text="{l:T Ed_ExistingLabel}" Style="{StaticResource Label}"/>
        <ComboBox x:Name="CmbExisting" SelectionChanged="Existing_Changed">
          <ComboBoxItem Tag="RemoveAll" Content="{l:T Opt_ExistingRemoveAll}"/>
          <ComboBoxItem Tag="KeepNewer" Content="{l:T Opt_ExistingKeepNewer}"/>
          <ComboBoxItem Tag="InstallOver" Content="{l:T Opt_ExistingInstallOver}"/>
        </ComboBox>
        <TextBlock x:Name="ExistingHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        <CheckBox x:Name="ChkReinstall" Style="{StaticResource Switch}" Content="{l:T Ed_Reinstall}" Margin="0,10,0,0" Click="Reinstall_Click"/>
        <TextBlock x:Name="ReinstallHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        <TextBlock x:Name="DefaultsHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        <CheckBox x:Name="ChkSaveDefaults" Style="{StaticResource Switch}" Content="{l:T Batch_SaveDefaults}" Margin="0,10,0,0"/>

        <!-- Deploy: each package published to Intune as soon as it is generated -->
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
          <StackPanel>
            <CheckBox x:Name="ChkPublish" Style="{StaticResource Switch}" Content="{l:T Batch_Publish}" FontWeight="SemiBold" Checked="Publish_Changed" Unchecked="Publish_Changed"/>
            <TextBlock x:Name="PublishConnection" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            <StackPanel x:Name="PublishPanel" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:T Batch_IfExists}" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbIfExists">
                    <ComboBoxItem Tag="Update" Content="{l:T Batch_IfExistsUpdate}"/>
                    <ComboBoxItem Tag="Supersede" Content="{l:T Batch_IfExistsSupersede}"/>
                    <ComboBoxItem Tag="CreateNew" Content="{l:T Batch_IfExistsNew}"/>
                    <ComboBoxItem Tag="Fail" Content="{l:T Batch_IfExistsSkip}"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:T Publish_Assign}" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbAssign" SelectionChanged="Assign_Changed">
                    <ComboBoxItem Tag="none|AllUsers" Content="{l:T Publish_AssignNone}"/>
                    <ComboBoxItem Tag="available|Group" Content="{l:T Publish_AssignAvailableGroup}"/>
                    <ComboBoxItem Tag="available|AllUsers" Content="{l:T Publish_AssignAvailableAll}"/>
                    <ComboBoxItem Tag="required|Group" Content="{l:T Publish_AssignRequiredGroup}"/>
                    <ComboBoxItem Tag="required|AllUsers" Content="{l:T Publish_AssignRequiredUsers}"/>
                    <ComboBoxItem Tag="required|AllDevices" Content="{l:T Publish_AssignRequiredDevices}"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <StackPanel x:Name="GroupPanel" Visibility="Collapsed">
                <TextBlock Text="{l:T Publish_Group}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtGroup" FontFamily="{StaticResource MonoFont}"/>
              </StackPanel>
              <TextBlock Text="{l:T Batch_PublishHint}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    </ScrollViewer>

    <!-- Applications -->
    <DockPanel Grid.Column="2">
      <TextBlock x:Name="ListTitle" DockPanel.Dock="Top" Style="{StaticResource Overline}" Margin="2,0,0,8"/>
      <ListBox x:Name="Items" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="{Binding AvatarColor}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,10,0">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding InstallerLabel}" Style="{StaticResource MutedText}" FontSize="12"/>
                <Grid Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding PercentText}" MinWidth="40" TextAlignment="Right" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource Ink}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding MessageLine}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button Style="{StaticResource GhostButton}" Content="{l:T Batch_OpenInEditor}" Tag="{Binding}" Click="OpenInEditor_Click" HorizontalAlignment="Left"
                        Margin="-8,2,0,0" Visibility="{Binding CanOpenInEditor, Converter={StaticResource Visible}}"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Style="{StaticResource StateText}" VerticalAlignment="Top" Margin="0,2,4,0"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    </Grid>

    <!-- Actions -->
    <DockPanel Grid.Row="2" Margin="0,0,0,0" LastChildFill="False">
      <Button x:Name="BtnOpenFolder" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{l:T Batch_OpenPackages}" Click="OpenPackages_Click" Visibility="Collapsed" Margin="-8,0,0,0"/>
      <Button x:Name="BtnReport" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{l:T Batch_CopyReport}" Click="CopyReport_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="Summary" DockPanel.Dock="Left" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="8,0,0,0"/>
      <Button x:Name="BtnStart" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Start_Click" MinWidth="150" Margin="8,0,0,0"/>
      <Button x:Name="BtnClose" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="Close_Click" MinWidth="96"/>
    </DockPanel>
  </Grid>
</v:DialogWindow>
