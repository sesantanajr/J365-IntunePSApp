<UserControl x:Class="J365.IntunePSApp.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:J365.IntunePSApp.Localization">
  <Grid Margin="28,6,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{l:T Catalog_Title}" Style="{StaticResource PageTitle}"/>
      <TextBlock x:Name="Subtitle" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,4,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,16,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="Search" FontSize="15" Padding="42,10,12,10" VerticalContentAlignment="Center" TextChanged="Search_TextChanged"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Muted}" Margin="15,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <TextBlock x:Name="SearchHint" Text="{l:T Catalog_SearchHint}" Foreground="{DynamicResource Faint}" FontSize="15" Margin="44,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <CheckBox x:Name="OnlySupported" Grid.Column="1" Style="{StaticResource Switch}" Content="{l:T Catalog_OnlySupported}" ToolTip="{l:T Catalog_OnlySupportedTip}" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
    </Grid>

    <!-- Database not downloaded -->
    <Border x:Name="EmptyState" Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="32,28" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Brand}" HorizontalAlignment="Center"/>
        <TextBlock Text="{l:T Catalog_EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="520" Text="{l:T Catalog_EmptyText}"/>
        <Button Content="{l:T Catalog_Download}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Download_Click"/>
      </StackPanel>
    </Border>

    <Grid x:Name="Main" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- The list keeps its 440 px on wide windows and shrinks with narrow ones. -->
        <ColumnDefinition Width="9*" MinWidth="300" MaxWidth="440"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="11*"/>
      </Grid.ColumnDefinitions>

      <DockPanel>
        <TextBlock x:Name="ResultInfo" DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="2,0,0,8"/>
        <!-- Batch: the applications ticked in the list are packaged together with the same settings -->
        <Border x:Name="BatchBar" DockPanel.Dock="Bottom" Background="{DynamicResource BrandSoft}" CornerRadius="12" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Batch_Click" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T Catalog_BatchPackage}"/></StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T Catalog_BatchClear}" Click="BatchClear_Click"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="BatchCount" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}"/>
              <TextBlock x:Name="BatchNames" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <ListBox x:Name="Results" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource AppListItem}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsQueued, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{l:T Catalog_BatchTip}"
                          IsEnabled="{Binding CanDeploy}" Focusable="False"/>
                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding AvatarColor}">
                  <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Right"/>
                  <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Details -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
        <Grid>
          <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE71E;" Style="{StaticResource Icon}" FontSize="36" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:T Catalog_NoSelection}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,10,0,0"/>
          </StackPanel>
          <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="26,24">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="DAvatar" Width="64" Height="64" CornerRadius="16">
                  <Grid>
                    <TextBlock x:Name="DInitials" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- The official logo of an application of the Microsoft Store -->
                    <Image x:Name="DLogo" Width="52" Height="52" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="DName" Style="{StaticResource PageTitle}" FontSize="22" TextWrapping="Wrap"/>
                  <TextBlock x:Name="DPublisher" Style="{StaticResource MutedText}" FontSize="13.5"/>
                </StackPanel>
              </Grid>
              <WrapPanel Margin="0,14,0,0">
                <Border Style="{StaticResource Chip}"><TextBlock x:Name="DVersion" Foreground="{DynamicResource Brand}" FontSize="12" FontWeight="SemiBold"/></Border>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource Subtle2}"><TextBlock x:Name="DId" Foreground="{DynamicResource Ink2}" FontSize="12" FontFamily="{StaticResource MonoFont}"/></Border>
                <Border x:Name="DLicenseChip" Style="{StaticResource Chip}" Background="{DynamicResource Subtle2}"><TextBlock x:Name="DLicense" Foreground="{DynamicResource Ink2}" FontSize="12"/></Border>
                <Border x:Name="DCuratedChip" Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}"><TextBlock Text="{l:T Catalog_Curated}" Foreground="{DynamicResource Success}" FontSize="12" FontWeight="SemiBold"/></Border>
                <Border x:Name="DStoreChip" Style="{StaticResource Chip}" Background="{DynamicResource BrandSoft}" Visibility="Collapsed"><TextBlock Text="{l:T Type_Store}" Foreground="{DynamicResource BrandText}" FontSize="12" FontWeight="SemiBold"/></Border>
              </WrapPanel>
              <TextBlock x:Name="DDescription" Style="{StaticResource Body}" FontSize="14" Margin="0,8,0,0"/>

              <TextBlock Text="{l:T Catalog_Installers}" Style="{StaticResource Overline}" Margin="0,22,0,8"/>
              <ListView x:Name="DInstallers" BorderBrush="{DynamicResource Line}" BorderThickness="1" MaxHeight="230" SelectionMode="Single" SelectionChanged="DInstallers_SelectionChanged">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="{l:T Catalog_ColArch}" Width="98" DisplayMemberBinding="{Binding ArchLabel}"/>
                    <GridViewColumn Header="{l:T Catalog_ColType}" Width="92" DisplayMemberBinding="{Binding TypeLabel}"/>
                    <GridViewColumn Header="{l:T Catalog_ColScope}" Width="86" DisplayMemberBinding="{Binding ScopeLabel}"/>
                    <GridViewColumn Header="{l:T Catalog_ColLanguage}" Width="106" DisplayMemberBinding="{Binding LocaleLabel}"/>
                    <GridViewColumn Header="{l:T Catalog_ColSilent}" Width="132" DisplayMemberBinding="{Binding SilentLabel}"/>
                  </GridView>
                </ListView.View>
              </ListView>
              <TextBlock x:Name="DInstallerInfo" Style="{StaticResource Hint}"/>

              <!-- Microsoft Store: published to Intune as "Microsoft Store app (new)", nothing is packaged -->
              <Border x:Name="DStore" Background="{DynamicResource BrandSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{l:T Catalog_StoreTitle}" Style="{StaticResource H3}"/>
                  <TextBlock x:Name="DStoreText" Style="{StaticResource Body}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border x:Name="DCuration" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="{l:T Catalog_CurationTitle}" Style="{StaticResource H3}"/>
                  <TextBlock x:Name="DCurationText" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <StackPanel x:Name="DDependencies" Visibility="Collapsed">
                <TextBlock Text="{l:T Catalog_Dependencies}" Style="{StaticResource Overline}" Margin="0,22,0,8"/>
                <ItemsControl x:Name="DDependencyList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brand}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T Catalog_DependenciesHint}" Style="{StaticResource Hint}"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="BtnPackage" Style="{StaticResource PrimaryButton}" Click="Package_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock x:Name="BtnPackageIcon" Text="&#xE896;" Style="{StaticResource Icon}" Foreground="White" Margin="0,0,10,0"/><TextBlock x:Name="BtnPackageText" Text="{l:T Catalog_DownloadAndPackage}"/></StackPanel>
                </Button>
                <Button x:Name="BtnQueue" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Queue_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock x:Name="BtnQueueIcon" Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock x:Name="BtnQueueText" Text="{l:T Catalog_BatchAdd}"/></StackPanel>
                </Button>
                <Button x:Name="BtnSite" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Site_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Catalog_Website}"/></StackPanel>
                </Button>
              </StackPanel>
              <Button x:Name="BtnSearchStore" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-8,10,0,0" Visibility="Collapsed" Click="SearchStore_Click">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="{l:T Catalog_SearchStore}"/></StackPanel>
              </Button>
              <TextBlock x:Name="DNote" Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{l:T Catalog_DownloadNote}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
