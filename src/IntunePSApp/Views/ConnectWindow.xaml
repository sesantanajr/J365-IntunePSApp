<v:DialogWindow x:Class="J365.IntunePSApp.Views.ConnectWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:l="clr-namespace:J365.IntunePSApp.Localization"
                xmlns:v="clr-namespace:J365.IntunePSApp.Views"
                Title="J365 IntunePSApp" Width="760" SizeToContent="Height" ResizeMode="NoResize">
  <v:DialogWindow.Resources>
    <Style x:Key="MethodTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
  </v:DialogWindow.Resources>

  <Grid Margin="28,22,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel>
      <Border x:Name="HeaderTile" Style="{StaticResource IconTile}" Width="50" Height="50" CornerRadius="15" VerticalAlignment="Top">
        <TextBlock x:Name="HeaderIcon" Text="&#xE753;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource BrandText}" HorizontalAlignment="Center"/>
      </Border>
      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderTitle" Style="{StaticResource H2}" FontSize="19" TextWrapping="Wrap"/>
        <TextBlock x:Name="HeaderText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,3,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- Scrolls when the window meets the height of the screen (notebooks at 125-150 %) instead of cutting the page -->
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid>

      <!-- ===================== 1. How to connect ===================== -->
      <StackPanel x:Name="PageChoose">
        <!-- Recommended: the application connects with a certificate of this computer (app-only, no secret) -->
        <RadioButton x:Name="OptCert" Style="{StaticResource ChoiceCard}" GroupName="connectMethod" IsChecked="True" Margin="0,0,0,10" Checked="Method_Checked">
          <DockPanel>
            <Border Style="{StaticResource IconTile}" Background="{DynamicResource SuccessSoft}" VerticalAlignment="Top"><TextBlock Text="&#xEB95;" Style="{StaticResource Icon}" Foreground="{DynamicResource Success}" FontSize="16" HorizontalAlignment="Center"/></Border>
            <StackPanel Margin="14,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T Connect_OptCert}" Style="{StaticResource MethodTitle}"/>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoft}" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{l:T Connect_Recommended}" Foreground="{DynamicResource SuccessText}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{l:T Connect_OptCertText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
        <RadioButton x:Name="OptAuto" Style="{StaticResource ChoiceCard}" GroupName="connectMethod" Margin="0,0,0,10" Checked="Method_Checked">
          <DockPanel>
            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{DynamicResource BrandText}" FontSize="16" HorizontalAlignment="Center"/></Border>
            <StackPanel Margin="14,0,0,0">
              <TextBlock Text="{l:T Connect_OptAuto}" Style="{StaticResource MethodTitle}"/>
              <TextBlock Text="{l:T Connect_OptAutoText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
        <RadioButton x:Name="OptCode" Style="{StaticResource ChoiceCard}" GroupName="connectMethod" Margin="0,0,0,10" Checked="Method_Checked">
          <DockPanel>
            <Border Style="{StaticResource IconTile}" Background="{DynamicResource InfoSoft}" VerticalAlignment="Top"><TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Foreground="{DynamicResource Info}" FontSize="16" HorizontalAlignment="Center"/></Border>
            <StackPanel Margin="14,0,0,0">
              <TextBlock Text="{l:T Connect_OptCode}" Style="{StaticResource MethodTitle}"/>
              <TextBlock Text="{l:T Connect_OptCodeText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
        <RadioButton x:Name="OptShell" Style="{StaticResource ChoiceCard}" GroupName="connectMethod" Margin="0,0,0,4" Checked="Method_Checked">
          <DockPanel>
            <Border Style="{StaticResource IconTile}" Background="{DynamicResource Subtle2}" VerticalAlignment="Top"><TextBlock Text="&#xE756;" Style="{StaticResource Icon}" Foreground="{DynamicResource Ink2}" FontSize="16" HorizontalAlignment="Center"/></Border>
            <StackPanel Margin="14,0,0,0">
              <TextBlock Text="{l:T Connect_OptShell}" Style="{StaticResource MethodTitle}"/>
              <TextBlock Text="{l:T Connect_OptShellText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>

        <!-- What the automatic setup needs, and what Microsoft will show -->
        <Border x:Name="AutoInfo" Style="{StaticResource Inset}" Margin="0,12,0,0" Padding="18,14">
          <StackPanel>
            <TextBlock Text="{l:T Connect_BeforeTitle}" Style="{StaticResource H3}"/>
            <DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Left" Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource BrandText}" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock x:Name="TxtReq1" Text="{l:T Connect_Req1Cert}" Style="{StaticResource Bullet}"/></DockPanel>
            <DockPanel Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Left" Text="&#xE823;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource BrandText}" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="{l:T Connect_Req2}" Style="{StaticResource Bullet}" Margin="0"/>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,3,0,0" Click="Pim_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="{l:T Connect_OpenPim}"/><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="5,1,0,0"/></StackPanel>
                </Button>
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource BrandText}" VerticalAlignment="Top" Margin="0,2,0,0"/><TextBlock Text="{l:T Connect_Req3}" Style="{StaticResource Bullet}"/></DockPanel>
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{l:T Connect_AdminAccount}" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtAdminHint"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{l:T Connect_AdminAccountHint}" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ===================== 2. Connection code or IDs ===================== -->
      <StackPanel x:Name="PageCode" Visibility="Collapsed">
        <TextBlock Text="{l:T Connect_CodeLabel}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtCode" FontFamily="{StaticResource MonoFont}" TextChanged="Code_Changed"/>
        <TextBlock Text="{l:T Connect_CodeHint}" Style="{StaticResource Hint}"/>
        <TextBlock Text="{l:T Connect_CodeOr}" Style="{StaticResource Overline}" Margin="0,20,0,0"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{l:T Publish_Tenant}" Style="{StaticResource Label}"/><TextBox x:Name="TxtTenant" FontFamily="{StaticResource MonoFont}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{l:T Publish_Client}" Style="{StaticResource Label}"/><TextBox x:Name="TxtClient" FontFamily="{StaticResource MonoFont}"/></StackPanel>
        </Grid>
        <TextBlock x:Name="CodeError" Foreground="{DynamicResource DangerText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <!-- ===================== 3. Azure Cloud Shell ===================== -->
      <StackPanel x:Name="PageShell" Visibility="Collapsed">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrandSoft}" VerticalAlignment="Top"><TextBlock Text="1" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,2,0,0">
            <TextBlock Text="{l:T Connect_Shell1}" Style="{StaticResource Body}"/>
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenShell_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T Connect_OpenShell}"/><TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="10" Margin="7,1,0,0"/></StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,18,0,0">
          <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrandSoft}" VerticalAlignment="Top"><TextBlock Text="2" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,2,0,0">
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource SegmentTrack}" Padding="3" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ShellBash" Style="{StaticResource SegmentItem}" GroupName="shellKind" Content="Bash" Padding="12,4" IsChecked="True" Checked="ShellKind_Checked"/>
                  <RadioButton x:Name="ShellPwsh" Style="{StaticResource SegmentItem}" GroupName="shellKind" Content="PowerShell" Padding="12,4" Checked="ShellKind_Checked"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{l:T Connect_Shell2}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
            <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,10,0,0">
              <TextBox x:Name="TxtScript" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="NoWrap" Height="150"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="10,8"/>
            </Border>
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyScript_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="CopyScriptText" Text="{l:T Connect_CopyCommand}"/></StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
        <DockPanel Margin="0,18,0,0">
          <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrandSoft}" VerticalAlignment="Top"><TextBlock Text="3" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrandText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Margin="12,2,0,0">
            <TextBlock Text="{l:T Connect_Shell3}" Style="{StaticResource Body}"/>
            <TextBox x:Name="TxtShellResult" FontFamily="{StaticResource MonoFont}" Margin="0,8,0,0" TextChanged="Code_Changed"/>
            <TextBlock x:Name="ShellError" Foreground="{DynamicResource DangerText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>

      <!-- ===================== 4. Progress ===================== -->
      <StackPanel x:Name="PageProgress" Visibility="Collapsed">
        <ItemsControl x:Name="StepList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border x:Name="dot" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Subtle2}" VerticalAlignment="Top">
                  <Grid>
                    <TextBlock x:Name="num" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="icon" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                      <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                    </TextBlock>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,5,0,0">
                  <TextBlock x:Name="title" Text="{Binding Title}" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="detail" Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Detail}" Value="">
                  <Setter TargetName="detail" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                  <Setter TargetName="dot" Property="Background" Value="{DynamicResource BrandSoft}"/>
                  <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="icon" Property="Text" Value="&#xE895;"/>
                  <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource BrandText}"/>
                  <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Ink}"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="spin">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="icon" Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="spin"/>
                  </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                  <Setter TargetName="dot" Property="Background" Value="{DynamicResource SuccessSoft}"/>
                  <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="icon" Property="Text" Value="&#xE73E;"/>
                  <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Success}"/>
                  <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Ink}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Warning">
                  <Setter TargetName="dot" Property="Background" Value="{DynamicResource WarningSoft}"/>
                  <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="icon" Property="Text" Value="&#xE7BA;"/>
                  <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Warning}"/>
                  <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Ink}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                  <Setter TargetName="dot" Property="Background" Value="{DynamicResource DangerSoft}"/>
                  <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="icon" Property="Text" Value="&#xE711;"/>
                  <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource Danger}"/>
                  <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Ink}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="BrowserHint" Style="{StaticResource Notice}" Margin="0,4,0,0" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE774;" Style="{StaticResource Icon}" Foreground="{DynamicResource BrandText}" FontSize="16" Margin="0,1,12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="BrowserHintText" Foreground="{DynamicResource Ink2}" FontSize="12.5" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
      </StackPanel>

      <!-- ===================== 5. Result ===================== -->
      <StackPanel x:Name="PageResult" Visibility="Collapsed">
        <Border x:Name="ResultBox" Style="{StaticResource NoticeSuccess}" Margin="0" Padding="16,14">
          <DockPanel>
            <Border x:Name="ResultTile" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Background="{DynamicResource CardBg}" VerticalAlignment="Top" Margin="0,0,14,0">
              <TextBlock x:Name="ResultIcon" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel>
              <TextBlock x:Name="ResultTitle" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
              <TextBox x:Name="ResultText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink2}" FontSize="12.5"
                       TextWrapping="Wrap" Padding="0" Margin="0,3,0,0" IsTabStop="False" FocusVisualStyle="{x:Null}"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid x:Name="SuccessDetails" Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l:T Connect_DetailAccount}" Style="{StaticResource Overline}"/>
            <TextBlock x:Name="DetailAccount" Foreground="{DynamicResource Ink}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{l:T Settings_IntuneTenantLabel}" Style="{StaticResource Overline}"/>
            <TextBlock x:Name="DetailTenant" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="{l:T Settings_IntuneClientLabel}" Style="{StaticResource Overline}"/>
            <TextBlock x:Name="DetailClient" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="CausesTitle" Text="{l:T Connect_CausesTitle}" Style="{StaticResource H3}" Margin="0,18,0,8"/>
        <StackPanel x:Name="Causes"/>
      </StackPanel>
    </Grid>
    </ScrollViewer>

    <!-- Buttons -->
    <DockPanel Grid.Row="2" Margin="0,22,0,0" LastChildFill="False">
      <Button x:Name="BtnExtra" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="8,6" Click="Extra_Click" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock x:Name="BtnExtraText"/></StackPanel>
      </Button>
      <Button x:Name="BtnPrimary" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Primary_Click" IsDefault="True"/>
      <Button x:Name="BtnSecondary" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" MinWidth="110" Margin="0,0,8,0" Click="Secondary_Click"/>
    </DockPanel>
  </Grid>
</v:DialogWindow>
