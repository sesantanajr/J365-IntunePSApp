<Window x:Class="J365.IntunePSApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:J365.IntunePSApp.Localization"
        Title="J365 IntunePSApp" Width="1360" Height="880" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <!-- 256 px, or 64 px (icons only) when the window is narrow: see MainWindow.ApplyResponsiveLayout. -->
      <ColumnDefinition x:Name="SidebarColumn" Width="256"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== Sidebar ===================== -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel x:Name="SidebarPanel" Margin="16,14,16,14">
        <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
          <Border x:Name="BrandIcon" Width="46" Height="46" CornerRadius="12" Background="#14FFFFFF" Margin="0,0,12,0">
            <Image Source="Assets/j365-cloud.png" Width="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel x:Name="BrandText" VerticalAlignment="Center">
            <TextBlock Text="IntunePSApp" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="{l:T Brand_By}" Foreground="#8FA6C6" FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom">
          <!-- Application database -->
          <Border x:Name="DatabaseCard" CornerRadius="12" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,11" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Foreground="#7FD3F7" FontSize="15" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T Main_Database}" Foreground="White" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="CatalogCount" Text="—" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
              <TextBlock x:Name="CatalogDate" Foreground="#8FA6C6" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="BtnCatalogUpdate" Content="{l:T Main_CheckUpdates}" Style="{StaticResource HeroOutlineButton}" FontSize="12.5" Padding="10,6" Margin="0,9,0,0"
                      Click="CatalogUpdate_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
          </Border>

          <!-- Credits -->
          <Border CornerRadius="12" Background="#0AFFFFFF" Padding="12,10,12,8" Margin="0,0,0,8">
            <StackPanel>
              <!-- Jornada 365 logo (the one of the blog); on a white badge so it reads on the dark sidebar. -->
              <Button Style="{StaticResource LogoBadge}" Click="Blog_Click" ToolTip="{l:T Credits_BlogTip}" Margin="0,0,0,9">
                <Image Source="Assets/j365-logo.png" Height="50" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Button>
              <TextBlock Text="{l:T Credits_CreatedBy}" Foreground="#8FA6C6" FontSize="11.5" Margin="2,0,0,0"/>
              <Button Style="{StaticResource SidebarLink}" Foreground="White" Padding="2,2" HorizontalAlignment="Left" Click="Author_Click" ToolTip="{l:T Credits_LinkedInTip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="AuthorText" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="7,2,0,0" Foreground="#7FD3F7"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource SidebarLink}" Padding="2,2" HorizontalAlignment="Left" Click="Psadt_Click" ToolTip="psappdeploytoolkit.com">
                <TextBlock Text="{l:T Credits_BasedOn}" FontSize="11.5" TextWrapping="Wrap"/>
              </Button>
            </StackPanel>
          </Border>

          <DockPanel LastChildFill="False">
            <Border DockPanel.Dock="Right" CornerRadius="8" Background="#12FFFFFF" Padding="2" ToolTip="{l:T Main_LanguageTip}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LangEn" Style="{StaticResource LangToggle}" GroupName="langSide" Content="EN" Tag="en" Checked="Lang_Checked"/>
                <RadioButton x:Name="LangPt" Style="{StaticResource LangToggle}" GroupName="langSide" Content="PT" Tag="pt-BR" Checked="Lang_Checked"/>
              </StackPanel>
            </Border>
            <Button DockPanel.Dock="Left" Style="{StaticResource SidebarLink}" Click="Blog_Click" ToolTip="jornada365.cloud">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,5,0"/><TextBlock Text="Blog"/></StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource SidebarLink}" Click="Repo_Click" ToolTip="{l:T Main_RepoTip}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="12" Margin="0,1,5,0"/><TextBlock Text="GitHub"/></StackPanel>
            </Button>
          </DockPanel>
          <TextBlock x:Name="VersionText" Foreground="#6F86A8" FontSize="11.5" Margin="6,6,0,0"/>
        </StackPanel>

        <StackPanel x:Name="NavPanel">
          <TextBlock x:Name="MenuLabel" Text="{l:T Main_Menu}" Style="{StaticResource Overline}" Foreground="#6F86A8" Margin="6,0,0,10"/>
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" Tag="home" Checked="Nav_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="{l:T Nav_Home}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavCatalog" Style="{StaticResource NavItem}" GroupName="nav" Tag="catalog" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="{l:T Nav_Catalog}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" GroupName="nav" Tag="editor" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="{l:T Nav_Editor}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavPackages" Style="{StaticResource NavItem}" GroupName="nav" Tag="packages" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="{l:T Nav_Packages}"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="{l:T Nav_Settings}"/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== Content ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock x:Name="CaptionText" Text="J365 IntunePSApp" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="28,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="{l:T Main_Minimize}"/>
          <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="{l:T Main_Maximize}"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{l:T Common_Close}"/>
        </StackPanel>
      </Grid>

      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FBFCFE">
        <DockPanel Margin="20,0">
          <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusLeft" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===================== Notifications ===================== -->
    <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,24,0" Width="380"/>

    <!-- ===================== Busy ===================== -->
    <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#660B1A33" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Effect="{StaticResource PopShadow}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
        <StackPanel>
          <TextBlock x:Name="BusyTitle" Style="{StaticResource H2}"/>
          <TextBlock x:Name="BusyText" Style="{StaticResource MutedText}" Margin="0,6,0,14" TextWrapping="Wrap"/>
          <ProgressBar x:Name="BusyProgress" Height="6" IsIndeterminate="True"/>
          <Button x:Name="BusyCancel" Content="{l:T Common_Cancel}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="BusyCancel_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===================== First run: automatic setup ===================== -->
    <Grid x:Name="SetupOverlay" Grid.ColumnSpan="2" Background="#CC0B1A33" Visibility="Collapsed">
      <Border Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Background="{StaticResource CardBg}" Effect="{StaticResource PopShadow}">
        <StackPanel>
          <Border CornerRadius="16,16,0,0" Background="{StaticResource HeroBrush}" Padding="28,24">
            <DockPanel>
              <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Background="#18FFFFFF" Padding="2">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="SetupLangEn" Style="{StaticResource LangToggle}" GroupName="langSetup" Content="English" Tag="en" Checked="Lang_Checked"/>
                  <RadioButton x:Name="SetupLangPt" Style="{StaticResource LangToggle}" GroupName="langSetup" Content="Português" Tag="pt-BR" Checked="Lang_Checked"/>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Border Width="52" Height="52" CornerRadius="14" Background="#14FFFFFF" Margin="0,0,16,0" VerticalAlignment="Top">
                  <Image Source="Assets/j365-cloud.png" Width="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center" MaxWidth="360">
                  <TextBlock Text="{l:T Setup_Title}" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{l:T Setup_Subtitle}" Foreground="#C7D8EE" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          <StackPanel Margin="28,22,28,24">
            <ItemsControl x:Name="SetupList" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Subtle}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,14,0">
                      <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Color}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5"/>
                      <TextBlock Text="{Binding Detail}" Foreground="{Binding Color}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                   Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{Binding Color}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="14,2,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SetupNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5"/>
            <DockPanel Margin="0,18,0,0" LastChildFill="False">
              <Button x:Name="SetupInstall" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="6,6" Click="SetupInstall_Click" ToolTip="{l:T Setup_InstallTip}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="{l:T Setup_InstallForUser}"/></StackPanel>
              </Button>
              <Button x:Name="SetupContinue" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="SetupContinue_Click" MinWidth="150" IsEnabled="False"/>
              <Button x:Name="SetupRetry" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{l:T Setup_Retry}" Click="SetupRetry_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
