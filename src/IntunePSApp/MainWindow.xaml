<Window x:Class="J365.IntunePSApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J365 IntunePSApp" Width="1360" Height="880" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="256"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ===================== Barra lateral ===================== -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
      <DockPanel Margin="16,14,16,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
          <Border Width="46" Height="46" CornerRadius="12" Background="#14FFFFFF" Margin="0,0,12,0">
            <Image Source="Assets/j365-cloud.png" Width="36" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="IntunePSApp" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="por Jornada 365" Foreground="#8FA6C6" FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border CornerRadius="12" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Foreground="#7FD3F7" FontSize="15" Margin="0,0,8,0"/>
                <TextBlock Text="Banco de dados" Foreground="White" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="CatalogCount" Text="—" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock x:Name="CatalogDate" Text="não baixado" Foreground="#8FA6C6" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="BtnCatalogUpdate" Content="Atualizar agora" Style="{StaticResource HeroOutlineButton}" FontSize="12.5" Padding="10,6" Margin="0,10,0,0" Click="CatalogUpdate_Click"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="VersionText" Foreground="#6F86A8" FontSize="11.5" Margin="4,0,0,4"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Button Style="{StaticResource GhostButton}" Foreground="#9FC7F0" Padding="4,3" Click="Blog_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="jornada365.cloud" FontSize="12"/></StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Foreground="#9FC7F0" Padding="4,3" Margin="6,0,0,0" Click="Repo_Click">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="GitHub" FontSize="12"/></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel>
          <TextBlock Text="MENU" Style="{StaticResource Overline}" Foreground="#6F86A8" Margin="6,0,0,10"/>
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" Tag="home" Checked="Nav_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Início"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavCatalog" Style="{StaticResource NavItem}" GroupName="nav" Tag="catalog" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Catálogo de apps"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" GroupName="nav" Tag="editor" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Novo pacote"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavPackages" Style="{StaticResource NavItem}" GroupName="nav" Tag="packages" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Pacotes gerados"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Configurações"/></StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===================== Conteudo ===================== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock x:Name="CaptionText" Text="J365 IntunePSApp" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="28,0,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimizar"/>
          <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximizar"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
        </StackPanel>
      </Grid>

      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FBFCFE">
        <DockPanel Margin="20,0">
          <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusLeft" Text="Pronto" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ===================== Notificacoes ===================== -->
    <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,50,24,0" Width="380"/>

    <!-- ===================== Ocupado ===================== -->
    <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#660B1A33" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Effect="{StaticResource PopShadow}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
        <StackPanel>
          <TextBlock x:Name="BusyTitle" Style="{StaticResource H2}" Text="Aguarde..."/>
          <TextBlock x:Name="BusyText" Style="{StaticResource MutedText}" Margin="0,6,0,14"/>
          <ProgressBar x:Name="BusyProgress" Height="6" IsIndeterminate="True"/>
          <Button x:Name="BusyCancel" Content="Cancelar" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="BusyCancel_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
