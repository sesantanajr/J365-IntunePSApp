<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme: the same keys as Themes/Light.xaml (see the note there). -->

  <!-- ===================== Brand ===================== -->
  <Color x:Key="NavyColor">#0E1A33</Color>
  <Color x:Key="Navy2Color">#14284F</Color>
  <Color x:Key="BrandColor">#4C7DFF</Color>
  <Color x:Key="CyanColor">#38C6F4</Color>
  <SolidColorBrush x:Key="Navy" Color="#1B2A4A"/>
  <SolidColorBrush x:Key="Brand" Color="#4C7DFF"/>
  <SolidColorBrush x:Key="BrandHover" Color="#6690FF"/>
  <SolidColorBrush x:Key="BrandPressed" Color="#3A69EA"/>
  <SolidColorBrush x:Key="BrandSoft" Color="#162246"/>
  <SolidColorBrush x:Key="BrandSoft2" Color="#273C78"/>
  <SolidColorBrush x:Key="BrandText" Color="#8AACFF"/>
  <SolidColorBrush x:Key="Cyan" Color="#38C6F4"/>
  <SolidColorBrush x:Key="OnBrand" Color="#FFFFFF"/>

  <!-- ===================== Neutrals ===================== -->
  <SolidColorBrush x:Key="PageBg" Color="#10141E"/>
  <SolidColorBrush x:Key="CardBg" Color="#192130"/>
  <SolidColorBrush x:Key="Subtle" Color="#161D2C"/>
  <SolidColorBrush x:Key="Subtle2" Color="#1C2435"/>
  <SolidColorBrush x:Key="Ink" Color="#EEF2F8"/>
  <SolidColorBrush x:Key="Ink2" Color="#C7D0DF"/>
  <SolidColorBrush x:Key="Muted" Color="#A8B5CA"/>
  <SolidColorBrush x:Key="Faint" Color="#8B9BB3"/>
  <SolidColorBrush x:Key="Line" Color="#303C50"/>
  <SolidColorBrush x:Key="Line2" Color="#313C52"/>
  <SolidColorBrush x:Key="SurfaceHover" Color="#1A2233"/>
  <SolidColorBrush x:Key="SurfacePressed" Color="#20293B"/>
  <SolidColorBrush x:Key="SelectedBg" Color="#17213B"/>
  <SolidColorBrush x:Key="InputBg" Color="#141B28"/>
  <SolidColorBrush x:Key="TrackOff" Color="#3A4559"/>
  <SolidColorBrush x:Key="CaptionHover" Color="#16FFFFFF"/>
  <SolidColorBrush x:Key="StatusBarBg" Color="#0D121C"/>
  <SolidColorBrush x:Key="Overlay" Color="#A6000000"/>
  <SolidColorBrush x:Key="OverlayStrong" Color="#E6040710"/>
  <SolidColorBrush x:Key="StepActive" Color="#3D6BF0"/>
  <SolidColorBrush x:Key="Avatar" Color="#24365E"/>

  <!-- ===================== Status ===================== -->
  <SolidColorBrush x:Key="Success" Color="#3CC895"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#0F2920"/>
  <SolidColorBrush x:Key="SuccessLine" Color="#1D4A39"/>
  <SolidColorBrush x:Key="SuccessText" Color="#66D9AE"/>
  <SolidColorBrush x:Key="Warning" Color="#F1B04E"/>
  <SolidColorBrush x:Key="WarningSoft" Color="#2B2113"/>
  <SolidColorBrush x:Key="WarningLine" Color="#4E3A1B"/>
  <SolidColorBrush x:Key="WarningText" Color="#F6C672"/>
  <SolidColorBrush x:Key="Danger" Color="#FF6B7A"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#311519"/>
  <SolidColorBrush x:Key="DangerLine" Color="#5B2731"/>
  <SolidColorBrush x:Key="DangerText" Color="#FF98A3"/>
  <SolidColorBrush x:Key="Info" Color="#52B4F6"/>
  <SolidColorBrush x:Key="InfoSoft" Color="#0F2334"/>
  <SolidColorBrush x:Key="InfoLine" Color="#1E415D"/>
  <SolidColorBrush x:Key="InfoText" Color="#80C9F8"/>

  <!-- ===================== Sidebar ===================== -->
  <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#070A12" Offset="0"/>
    <GradientStop Color="#0A0F1C" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="SidebarGlow">
    <GradientStop Color="#3D3B76F6" Offset="0"/>
    <GradientStop Color="#0E3B76F6" Offset="0.55"/>
    <GradientStop Color="#003B76F6" Offset="1"/>
  </RadialGradientBrush>
  <LinearGradientBrush x:Key="SidebarAccent" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#38D2F5" Offset="0"/>
    <GradientStop Color="#4C7DFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SidebarText" Color="#A3AEC2"/>
  <SolidColorBrush x:Key="SidebarTextStrong" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarMuted" Color="#8B9BB3"/>
  <SolidColorBrush x:Key="SidebarHover" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="SidebarActive" Color="#19FFFFFF"/>
  <SolidColorBrush x:Key="SidebarLine" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="SidebarCard" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="SidebarCardBorder" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="SidebarLinkText" Color="#9DBBEB"/>
  <SolidColorBrush x:Key="SidebarIcon" Color="#7DD3FC"/>

  <!-- ===================== Hero and primary actions ===================== -->
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0E1733" Offset="0"/>
    <GradientStop Color="#152A62" Offset="0.55"/>
    <GradientStop Color="#2D58DA" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="HeroGlow">
    <GradientStop Color="#4038D2F5" Offset="0"/>
    <GradientStop Color="#0F38D2F5" Offset="0.6"/>
    <GradientStop Color="#0038D2F5" Offset="1"/>
  </RadialGradientBrush>
  <SolidColorBrush x:Key="HeroText" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="HeroMuted" Color="#BFCDEA"/>
  <SolidColorBrush x:Key="HeroChip" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="HeroChipLine" Color="#2EFFFFFF"/>
  <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#5584FF" Offset="0"/>
    <GradientStop Color="#3F6EF2" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6690FF" Offset="0"/>
    <GradientStop Color="#4C7AF8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#4C7DFF" Offset="0"/>
    <GradientStop Color="#38C6F4" Offset="1"/>
  </LinearGradientBrush>

  <!-- ===================== Depth ===================== -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="2" Direction="270" Opacity="0.32" Color="#000000"/>
  <DropShadowEffect x:Key="PopShadow" BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000"/>
  <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000"/>

  <!-- ===================== WPF Fluent theme: brand accent instead of the Windows accent ===================== -->
  <Color x:Key="SystemAccentColor">#4C7DFF</Color>
  <Color x:Key="SystemAccentColorLight1">#6F95FF</Color>
  <Color x:Key="SystemAccentColorLight2">#8DAAFF</Color>
  <Color x:Key="SystemAccentColorLight3">#B5C8FF</Color>
  <Color x:Key="SystemAccentColorDark1">#3A69EA</Color>
  <Color x:Key="SystemAccentColorDark2">#2C55C7</Color>
  <Color x:Key="SystemAccentColorDark3">#1F3F9A</Color>
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8DAAFF"/>
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8DAAFF" Opacity="0.9"/>
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#8DAAFF" Opacity="0.8"/>
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#4C7DFF"/>
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B5C8FF"/>
  <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B5C8FF"/>
  <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8DAAFF"/>
  <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
    <LinearGradientBrush.RelativeTransform>
      <ScaleTransform ScaleY="-1" CenterY="0.5"/>
    </LinearGradientBrush.RelativeTransform>
    <GradientStop Offset="1.0" Color="#8DAAFF"/>
    <GradientStop Offset="1.0" Color="#12FFFFFF"/>
  </LinearGradientBrush>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
</ResourceDictionary>
